<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Board.Controls.MemoBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:appcontrols="using:NewSchool.Controls"
    xmlns:board="using:NewSchool.Board"
    xmlns:local="using:NewSchool.Board.Controls"
    mc:Ignorable="d">

    <Border Style="{StaticResource DashboardCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더: 제목 + 카테고리 필터 + 추가 -->
            <Border Grid.Row="0" Style="{StaticResource DashboardCardHeader}" Padding="8,5">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;" Style="{StaticResource DashboardCardHeaderIcon}"/>
                        <TextBlock Text="메모" Style="{StaticResource DashboardCardHeaderTitle}"/>
                    </StackPanel>
                    <ComboBox x:Name="CBoxCategoryFilter" Grid.Column="1" MinWidth="80"
                              AutomationProperties.Name="메모 분류 거르기"
                              VerticalAlignment="Center"
                              SelectionChanged="CBoxCategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="전체" Tag=""/>
                        <ComboBoxItem Content="수업" Tag="수업"/>
                        <ComboBoxItem Content="학급" Tag="학급"/>
                        <ComboBoxItem Content="업무" Tag="업무"/>
                        <ComboBoxItem Content="개인" Tag="개인"/>
                    </ComboBox>
                    <Button x:Name="BtnAddMemo" Grid.Column="3" Click="BtnAddMemo_Click"
                            AutomationProperties.Name="새 메모 추가"
                            Background="Transparent" Padding="6,2"
                            ToolTipService.ToolTip="새 메모 추가">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="추가" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 최근 메모: 고정 인라인 에디터 (첨부 없음) -->
            <Grid x:Name="RecentPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 최근 메모 헤더 -->
                <Grid Grid.Row="0" Padding="12,6"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkRecent" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="완료로 표시해 숨기기"
                              Click="ChkRecent_Click" ToolTipService.ToolTip="완료(숨김)"/>
                    <ComboBox x:Name="CBoxRecentCategory" Grid.Column="1" MinWidth="80"
                              AutomationProperties.Name="이 메모의 분류"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              SelectionChanged="CBoxRecentCategory_SelectionChanged">
                        <ComboBoxItem Content="수업" Tag="수업"/>
                        <ComboBoxItem Content="학급" Tag="학급"/>
                        <ComboBoxItem Content="업무" Tag="업무"/>
                        <ComboBoxItem Content="개인" Tag="개인"/>
                    </ComboBox>
                    <TextBlock x:Name="TxtRecentTitle" Grid.Column="2" VerticalAlignment="Center"
                               FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="BtnRecentOpenDialog" Grid.Column="3" Padding="8,4"
                            Click="BtnRecentOpenDialog_Click" AutomationProperties.Name="새 창으로 열기 (제목·첨부)" ToolTipService.ToolTip="새 창으로 열기 (제목·첨부)">
                        <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                    </Button>
                    <!-- ⚠ 글자가 StackPanel 안에 있으면 UIA 이름이 비어 있다 — Content 가
                         문자열일 때만 자동으로 이름이 된다(54차 실측: 낭독기가 "단추"라고만 읽었다). -->
                    <Button x:Name="BtnRecentSave" Grid.Column="4" Padding="8,4" Margin="4,0,0,0"
                            AutomationProperties.Name="메모 저장"
                            Click="BtnRecentSave_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                            <TextBlock Text="저장" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRecentDelete" Grid.Column="5" Padding="8,4" Margin="4,0,0,0"
                            Background="Transparent" Click="BtnRecentDelete_Click"
                            AutomationProperties.Name="삭제"
                            ToolTipService.ToolTip="삭제">
                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- 에디터 (적당한 높이로 제한, 긴 메모는 내부 스크롤 → 목록 공간 확보) -->
                <Border Grid.Row="1" Padding="4,4">
                    <appcontrols:RichTextEditor x:Name="Editor"
                                                Mode="Simple"
                                                ShowToolbar="False"
                                                MinHeight="120"
                                                MaxHeight="220"/>
                </Border>
            </Grid>

            <!-- 나머지 활성 메모: compact 목록 (클릭 → 다이얼로그 편집), 남은 공간 채움.
                 ⚠ StackPanel 에 줄을 다 만들지 말 것 — 보이는 줄만 만드는 ItemsRepeater 여야 한다.
                 체크박스 하나가 체크 애니메이션 때문에 약 0.45MB·핸들 11개를 쓴다. 예전처럼 전부
                 만들면 메모 500개 모래상자에서 체크박스만 약 220MB였다(2026-09-25 실측). -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="CompactRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:MemoRow">
                            <!-- 배경을 투명으로라도 깔아야 줄 전체가 눌린다(빈 곳 Tapped) -->
                            <Grid Padding="12,4,12,4" MinHeight="40" ColumnSpacing="8"
                                  Background="Transparent"
                                  BorderThickness="0,0,0,1"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  Tag="{x:Bind Memo}"
                                  Tapped="CompactItem_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 완료 체크 (탭은 체크박스가 소비 → 행 Tapped 미발생) -->
                                <CheckBox MinWidth="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="{x:Bind CheckName}"
                                          Tag="{x:Bind Memo}"
                                          Click="CompactCheck_Click"/>

                                <!-- 분류 배지 — 같은 색을 옅게 깔고 테두리로만 진하게(GetCategoryColor 주석) -->
                                <Border Grid.Column="1" BorderThickness="1" CornerRadius="3"
                                        Padding="6,2,6,2" VerticalAlignment="Center"
                                        Background="{x:Bind BadgeBackground}"
                                        BorderBrush="{x:Bind BadgeBorder}">
                                    <TextBlock Text="{x:Bind CategoryText}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </Border>

                                <!-- 제목 (+ 첨부 아이콘) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TitleText}" FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <FontIcon Glyph="&#xE723;" FontSize="10" Margin="6,0,0,0"
                                              Visibility="{x:Bind FileIconVisibility}"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{x:Bind DateText}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 빈 상태 -->
            <StackPanel x:Name="PanelEmpty" Grid.Row="2"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE70B;" FontSize="32"
                          Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                <TextBlock Text="메모가 없습니다" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 로딩 -->
            <ProgressRing x:Name="LoadingRing" Grid.Row="2" IsActive="False"
                          Width="32" Height="32"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
