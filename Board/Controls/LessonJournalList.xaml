<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Board.Controls.LessonJournalList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:NewSchool.Board.Controls"
    xmlns:board="using:NewSchool.Board"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 헤더/버튼 -->
            <RowDefinition Height="*"/>      <!-- 목록 -->
        </Grid.RowDefinitions>

        <!-- 헤더 영역 -->
        <Grid Grid.Row="0"
              Padding="12,8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <FontIcon Glyph="&#xE70F;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="수업 일지"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCount"
                           FontSize="12"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button x:Name="BtnAdd"
                        Click="BtnAdd_Click"
                        AutomationProperties.Name="수업 일지 쓰기"
                        ToolTipService.ToolTip="수업 일지 쓰기"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
                <Button x:Name="BtnRefresh"
                        Click="BtnRefresh_Click"
                        AutomationProperties.Name="새로고침"
                        ToolTipService.ToolTip="새로고침"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 목록 영역 -->
        <ListView x:Name="LvJournals"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="LvJournals_ItemClick"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="board:Post">
                    <Grid Padding="8,6" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>   <!-- 쓴 날 -->
                            <ColumnDefinition Width="*"/>    <!-- 제목 -->
                            <ColumnDefinition Width="Auto"/> <!-- 첨부 -->
                        </Grid.ColumnDefinitions>

                        <!-- 1행: 쓴 날 | 제목 | 첨부 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Bind local:LessonJournalListHelpers.ShortDate(DateTime)}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind Title}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>

                        <FontIcon Grid.Row="0" Grid.Column="2"
                                  Glyph="&#xE723;" FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  Visibility="{x:Bind FileIconVisibility}"/>

                        <!-- 2행: 본문 첫 줄 (있을 때만) -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{x:Bind local:LessonJournalListHelpers.Summary(PlainText)}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   Visibility="{x:Bind local:LessonJournalListHelpers.SummaryVisibility(PlainText)}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="36"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 빈 목록 메시지 -->
        <TextBlock x:Name="TxtEmpty"
                   Grid.Row="1"
                   Text="수업 일지가 없습니다."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"/>

        <!-- 로딩 -->
        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="1"
                      Width="40"
                      Height="40"
                      IsActive="False"
                      Visibility="Collapsed"/>
    </Grid>
</UserControl>
