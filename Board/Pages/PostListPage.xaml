<!-- PostListPage.xaml - Post 목록 페이지 (개선 버전) -->
<Page
    x:Class="NewSchool.Board.Pages.PostListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NewSchool.Board.Pages"
    xmlns:board="using:NewSchool.Board"
    xmlns:viewmodels="using:NewSchool.Board.ViewModels"
    xmlns:converters="using:NewSchool.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:DateTimeToStringConverter x:Key="DateTimeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnCtrlFInvoked"/>
        <!-- Ctrl 없이 PageUp/PageDown 을 쓰면 목록 안 스크롤을 가로챈다 -->
        <KeyboardAccelerator Modifiers="Control" Key="PageUp" Invoked="OnPreviousPageInvoked"/>
        <KeyboardAccelerator Modifiers="Control" Key="PageDown" Invoked="OnNextPageInvoked"/>
    </Page.KeyboardAccelerators>

    <!-- 화면 제목 줄은 두지 않는다 — 왼쪽 메뉴가 이미 같은 말("아카이브"·"업무 게시판"…)을
         하고 있어 한 줄을 그대로 되풀이했다. 목록에 그 높이를 넘긴다. -->
    <Grid Padding="20" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: 카테고리 + Subject 필터 + 액션 버튼 -->
        <Grid x:Name="FilterRow" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 카테고리 선택 -->
            <ComboBox x:Name="CategoryComboBox"
                          Grid.Column="0"
                          Width="150"
                          PlaceholderText="카테고리"
                          SelectionChanged="CategoryComboBox_SelectionChanged"
                          Margin="0,0,8,0"/>

            <!-- Subject 필터 (ShowSubjectFilter=true일 때만 표시) -->
            <ComboBox x:Name="SubjectFilterComboBox"
                          Grid.Column="1"
                          Width="150"
                          PlaceholderText="주제"
                          SelectionChanged="SubjectFilterComboBox_SelectionChanged"
                          Visibility="Collapsed"
                          Margin="0,0,8,0"/>

            <!-- 정렬 기준 -->
            <ComboBox x:Name="SortOrderComboBox"
                          Grid.Column="2"
                          Width="120"
                          SelectedIndex="0"
                          SelectionChanged="SortOrderComboBox_SelectionChanged"
                          Margin="0,0,8,0">
                <ComboBoxItem Content="최신순"/>
                <ComboBoxItem Content="오래된순"/>
                <ComboBoxItem Content="제목순"/>
                <ComboBoxItem Content="조회수순"/>
                <ComboBoxItem Content="작성자순"/>
            </ComboBox>

            <!-- 페이지당 개수 -->
            <ComboBox x:Name="PageSizeComboBox"
                          Grid.Column="3"
                          Width="100"
                          SelectedIndex="1"
                          SelectionChanged="PageSizeComboBox_SelectionChanged"
                          Margin="0,0,8,0">
                <ComboBoxItem Content="10개씩"/>
                <ComboBoxItem Content="20개씩"/>
                <ComboBoxItem Content="50개씩"/>
                <ComboBoxItem Content="100개씩"/>
            </ComboBox>

            <!-- ViewMode 전환 버튼 -->
            <Button x:Name="ViewModeToggleButton"
                        Grid.Column="5"
                        Click="ViewModeToggleButton_Click"
                        ToolTipService.ToolTip="보기 모드 전환"
                        Margin="4,0,0,0"
                        Visibility="Collapsed">
                <FontIcon x:Name="ViewModeIcon" Glyph="&#xE8F2;" FontSize="16"/>
            </Button>

            <!-- 새로고침 -->
            <Button Grid.Column="6"
                        Content="새로고침"
                        Click="RefreshButton_Click"
                        Margin="4,0,0,0">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </Button.KeyboardAccelerators>
            </Button>

            <!-- 새 글 작성 -->
            <Button Grid.Column="7"
                        Content="새 글 쓰기"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="4,0,0,0"
                        Click="NewPostButton_Click"/>
        </Grid>

        <!-- 필터 및 검색 영역 -->
        <!--<StackPanel x:Name="FilterPanel" Grid.Row="1" Spacing="8" Margin="0,0,0,12">


        </StackPanel>-->

        <!-- Post 목록 -->
        <Grid Grid.Row="1">
            <!-- 로딩 표시 (수동 제어) -->
            <ProgressRing x:Name="LoadingRing"
                          Width="60"
                          Height="60"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"/>

            <!-- 빈 목록 메시지 (수동 제어) -->
            <TextBlock x:Name="EmptyMessage"
                       Text="게시글이 없습니다."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="Collapsed"/>

            <!-- Table View (기본) -->
            <ScrollViewer x:Name="TableViewContainer" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 헤더 -->
                    <!-- ⚠ 아래 행 템플릿과 열 정의가 <b>같아야</b> 한다(머리글과 칸이 어긋난다).
                         두 곳으로 나뉜 자리라 BoardListLayoutTests 가 소스로 대조한다. -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Padding="12,6"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="4,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <!-- 작성자 컬럼: 현재 숨김 (미래 다중 사용자 지원 시 복원) -->
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="번호" FontWeight="Bold" HorizontalTextAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="제목" FontWeight="Bold" HorizontalTextAlignment="Left" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="작성자" FontWeight="Bold" HorizontalTextAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock Grid.Column="3" Text="날짜" FontWeight="Bold" HorizontalTextAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="조회" FontWeight="Bold" HorizontalTextAlignment="Center"/>
                    </Grid>

                    <!-- ItemsRepeater -->
                    <ItemsRepeater x:Name="PostsRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PostItemViewModel">
                                <!-- MinHeight="0": Button 기본 스타일의 MinHeight(32)가 바닥을 잡아
                                     아래 Padding 을 줄여도 행이 더 낮아지지 않는다. 행 높이는
                                     Grid 의 Padding 하나로만 정해지게 둔다. -->
                                <Button Click="PostItem_Click"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0"
                                        MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="1,0,1,1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        CornerRadius="0"
                                        Tag="{x:Bind}">
                                    <Button.Resources>
                                        <!-- 호버·누름 배경은 WinUI 기본값(테마 대응)을 그대로 쓴다.
                                             예전에는 거의 흰색(#FFF3F9FF)·연한 파랑(#FFD9ECFF)을 박아
                                             두었는데, 행 안의 글자는 테마 기본색이라 다크 테마에서
                                             마우스를 올린 행이 통째로 보이지 않았다.
                                             테두리만 계속 지운다(행 사이 선은 Button 쪽에서 그린다). -->
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                    </Button.Resources>


                                    <Grid Padding="12,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <!-- 작성자 컬럼: 현재 숨김 -->
                                            <ColumnDefinition Width="0"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 번호 -->
                                        <TextBlock Grid.Column="0"
                                                   HorizontalTextAlignment="Center"
                                                   Text="{x:Bind No}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>

                                        <!-- 제목 + 아이콘 -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="8,0,0,0">
                                            <FontIcon Glyph="&#xE718;"
                                                      FontSize="12"
                                                      Margin="0,0,6,0"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      ToolTipService.ToolTip="중요"
                                                      Visibility="{x:Bind PinIconVisibility}"/>

                                            <FontIcon Glyph="&#xE73E;"
                                                      FontSize="12"
                                                      Margin="0,0,6,0"
                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                      ToolTipService.ToolTip="확인"
                                                      Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <TextBlock Text="{x:Bind Title}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"
                                                       Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacityConverter}}"
                                                       FontSize="14"/>

                                            <FontIcon Glyph="&#xE8BD;"
                                                      FontSize="12"
                                                      Margin="8,0,0,0"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                      Visibility="{x:Bind CommentIconVisibility}"/>
                                            <TextBlock Text="{x:Bind CommentCount}"
                                                       FontSize="11"
                                                       Margin="3,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{x:Bind CommentIconVisibility}"/>

                                            <FontIcon Glyph="&#xE723;"
                                                      FontSize="12"
                                                      Margin="4,0,0,0"
                                                      Visibility="{x:Bind FileIconVisibility}"/>
                                        </StackPanel>

                                        <!-- 작성자 (숨김) -->
                                        <TextBlock Grid.Column="2"
                                                   HorizontalTextAlignment="Center"
                                                   Text="{x:Bind User}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Visibility="Collapsed"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- 날짜 -->
                                        <TextBlock Grid.Column="3"
                                                   HorizontalTextAlignment="Center"
                                                   Text="{x:Bind DateTime, Converter={StaticResource DateTimeConverter}, ConverterParameter='yyyy-MM-dd'}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <!-- 조회수 -->
                                        <TextBlock Grid.Column="4" 
                                                   HorizontalTextAlignment="Center"
                                                   Text="{x:Bind ReadCount}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>

                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

            <!-- Card View -->
            <ScrollViewer x:Name="CardViewContainer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsRepeater x:Name="CardViewRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PostItemViewModel">
                            <Button Click="PostItem_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="8"
                                    Tag="{x:Bind}">
                                <Grid Padding="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 제목 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <!-- 중요 글은 어떤 보기에서도 맨 앞에 오므로, 왜 앞에 있는지
                                             알 수 있게 표 보기와 같은 표시를 붙인다 -->
                                        <FontIcon Glyph="&#xE718;"
                                                  FontSize="12"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                  ToolTipService.ToolTip="중요"
                                                  Visibility="{x:Bind PinIconVisibility}"/>
                                        <FontIcon Glyph="&#xE73E;"
                                                  FontSize="12"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                  ToolTipService.ToolTip="확인"
                                                  Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethroughConverter}}"
                                                   Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacityConverter}}"/>
                                    </StackPanel>

                                    <!-- 내용 미리보기 -->
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind Content}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="3"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <!-- 메타 정보 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
                                        <!-- 작성자 (숨김) -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind User}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind DateTime, Converter={StaticResource DateTimeConverter}, ConverterParameter='yyyy-MM-dd'}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <FontIcon Glyph="&#xE8BD;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind CommentIconVisibility}"/>
                                        <TextBlock Text="{x:Bind CommentCount}" FontSize="11" Margin="-12,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind CommentIconVisibility}"/>
                                        <FontIcon Glyph="&#xE723;" FontSize="12" Visibility="{x:Bind FileIconVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Gallery View -->
            <ScrollViewer x:Name="GalleryViewContainer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsRepeater x:Name="GalleryViewRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:PostItemViewModel">
                            <Button Click="PostItem_Click"
                                    Width="220"
                                    Height="280"
                                    Padding="0"
                                    Margin="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="8"
                                    Tag="{x:Bind}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 썸네일 영역 (이미지가 있으면 표시, 없으면 아이콘) -->
                                    <Border Grid.Row="0"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            CornerRadius="8,8,0,0">
                                        <FontIcon Glyph="&#xE8A5;"
                                                  FontSize="48"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 정보 영역 -->
                                    <Grid Grid.Row="1" Padding="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 제목 (중요 글 표시는 표·카드 보기와 같은 아이콘) -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <FontIcon Glyph="&#xE718;"
                                                      FontSize="11"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Top"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      ToolTipService.ToolTip="중요"
                                                      Visibility="{x:Bind PinIconVisibility}"/>
                                            <TextBlock Text="{x:Bind Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- 메타 정보 -->
                                        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="4">
                                            <!-- 작성자 (숨김) -->
                                            <TextBlock Text="{x:Bind User}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                                            <TextBlock Text="{x:Bind DateTime, Converter={StaticResource DateTimeConverter}, ConverterParameter='yyyy-MM-dd'}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="220"
                                           MinItemHeight="280"
                                           MinColumnSpacing="0"
                                           MinRowSpacing="0"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- 페이징: ‹ 1 … 3 4 [5] 6 7 … 42 ›  (번호 칸은 코드에서 그린다 — RenderPager) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="PagerPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">

                <Button x:Name="PreviousButton"
                        Click="PreviousButton_Click"
                        IsEnabled="False"
                        MinWidth="36" Padding="8,4"
                        ToolTipService.ToolTip="이전 페이지 (Ctrl+PageUp)">
                    <FontIcon Glyph="&#xE76B;" FontSize="11"/>
                </Button>

                <!-- 페이지 번호 칸 -->
                <StackPanel x:Name="PageNumberPanel"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center"/>

                <Button x:Name="NextButton"
                        Click="NextButton_Click"
                        IsEnabled="False"
                        MinWidth="36" Padding="8,4"
                        ToolTipService.ToolTip="다음 페이지 (Ctrl+PageDown)">
                    <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                </Button>
            </StackPanel>

            <TextBlock x:Name="PageInfoText"
                       Grid.Column="2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <!-- 검색 영역 -->
        <Grid x:Name="SearchRow" Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <!-- UpdateSourceTrigger=PropertyChanged 필수: TextBox.Text 의 기본값은 LostFocus 라,
                     검색창에 치고 곧바로 Enter 를 누르면 포커스가 그대로여서 ViewModel.SearchText 에
                     아직 아무것도 넘어가지 않았다 — 직전 검색어(첫 시도면 빈 값)로 검색됐다.
                     버튼 클릭은 포커스가 옮겨가며 값이 넘어와 우연히 동작했다. -->
                <TextBox x:Name="SearchTextBox"
                             Width="300"
                             PlaceholderText="검색어 입력"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_KeyDown"
                             Margin="0,0,8,0"/>

                <CheckBox Content="제목"
                              IsChecked="{x:Bind ViewModel.SearchInTitle, Mode=TwoWay}"
                              Margin="0,0,8,0"/>

                <CheckBox Content="내용"
                              IsChecked="{x:Bind ViewModel.SearchInContent, Mode=TwoWay}"
                              Margin="0,0,8,0"/>

                <Button Content="검색"
                            Click="SearchButton_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
