<UserControl
    x:Class="NewSchool.Scheduler.DayCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:NewSchool.Scheduler"
    xmlns:newschool="using:NewSchool"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 색상 리소스는 전부 걷어냈다. 셀 배경·강조·배지는 ThemeResource 를 직접 쓰고
             (고정 밝은 색은 다크 테마에서 글씨를 삼킨다), 요일·휴일 글자색은 코드가
             인스턴스 브러시로 들고 있다. 여기 있던 아홉 개는 참조가 하나도 없었다. -->
        <!-- 컨버터 -->
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>

    </UserControl.Resources>

    <!-- 오른쪽과 아래쪽 테두리만 표시 (0,0,0.5,0.5) -->
    <Border x:Name="BrdBase"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0.5,0.5"
            CornerRadius="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            PointerEntered="BrdBase_PointerEntered"
            PointerExited="BrdBase_PointerExited">

        <Grid x:Name="GridBase">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 마우스 호버 효과 (배경 레이어)
                 ⚠ 이 두 레이어는 셀 전체를 덮고 날짜 글씨가 그 위에 올라간다. 밝은 색을 고정하면
                    다크 테마에서 "밝은 배경 + 밝은 글씨"가 되어 오늘·호버 칸의 날짜가 사라진다
                    (글씨는 테마 기본색을 따르기 때문이다). 배경도 테마를 따라가야 짝이 맞는다. -->
            <Border x:Name="HoverHighlight"
                    Grid.RowSpan="2"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <!-- 오늘 날짜 강조 효과 (배경 레이어) -->
            <Border x:Name="TodayHighlight"
                    Grid.RowSpan="2"
                    Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <!-- 헤더 영역 -->
            <Grid Grid.Row="0" Padding="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 날짜 (오늘 강조는 셀 전체 테두리(TodayHighlight)로 충분해 원형 배지는 생략) -->
                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock x:Name="LbDate"
                               FontWeight="Bold"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"/>
                </Grid>

                <!-- 날짜 이름 (공휴일 등) -->
                <TextBlock x:Name="TbDateName"
                           Grid.Column="1"
                           FontSize="9"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Bottom"
                           Opacity="0.8"/>

                <!-- 작업 개수 배지 -->
                <Border x:Name="TaskCountBadge" 
                        Grid.Column="2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="6,2"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TaskCountText" 
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- 이벤트+작업 목록 영역 -->
            <ScrollViewer x:Name="SV" 
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="2">
                <StackPanel>

                <!-- 이벤트 목록 (KEvent) -->
                <ItemsRepeater x:Name="EventsRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:KEvent">
                            <Border x:Name="EventItem"
                                    CornerRadius="3"
                                    Margin="2,1,2,1"
                                    Padding="4,2"
                                    Background="Transparent"
                                    Tag="{x:Bind}"
                                    PointerPressed="EventItem_PointerPressed"
                                    PointerEntered="EventItem_PointerEntered"
                                    PointerExited="EventItem_PointerExited">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="6" Height="6" CornerRadius="3"
                                            Margin="0,0,2,0"
                                            Background="{x:Bind local:DayCell.EventColorToBrush(DisplayColor), Mode=OneWay}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EvtTimeText"
                                               Text="{x:Bind TimeLabel, Mode=OneWay}"
                                               FontSize="{x:Bind local:DayCell.GetEventTimeFontSize(TimeLabel), Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind TimeLabel, Converter={StaticResource StringNotEmptyToVisibilityConverter}, Mode=OneWay}"/>
                                    <TextBlock x:Name="EvtTitleText"
                                               Text="{x:Bind Title, Mode=OneWay}"
                                               FontSize="{x:Bind local:DayCell.GetEventTitleFontSize(Title), Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 작업 목록 (KEvent, ItemType="task") -->
                <ItemsRepeater x:Name="TasksRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:KEvent">
                            <Grid Tag="{x:Bind}"
                                  PointerEntered="TaskItem_PointerEntered" 
                                  PointerExited="TaskItem_PointerExited"
                                  PointerPressed="TaskItem_PointerPressed"
                                  Background="Transparent"
                                  Margin="8,0,2,0"
                                  Padding="0"
                                  IsHitTestVisible="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>  <!-- 상태 버튼 -->
                                    <ColumnDefinition Width="*"/>     <!-- 제목 -->
                                </Grid.ColumnDefinitions>

                                <!-- 상태 토글 버튼 (글머리 역할) -->
                                <Button Grid.Column="0"
                                        Tag="{x:Bind}"
                                        Click="TaskToggleButton_Click"
                                        MinWidth="0" MinHeight="0"
                                        Padding="2,0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                    <TextBlock Text="{x:Bind local:DayCell.ToStatusLabel(IsDone), Mode=OneWay}"
                                               FontSize="8"
                                               Foreground="{x:Bind local:DayCell.ToStatusColor(IsDone), Mode=OneWay}"/>
                                </Button>

                                <!-- 제목 -->
                                <TextBlock x:Name="TaskTitleText"
                                           Grid.Column="1"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           FontSize="{x:Bind local:DayCell.GetTaskTitleFontSize(Title), Mode=OneWay}"
                                           TextDecorations="{x:Bind TextDecorations, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
