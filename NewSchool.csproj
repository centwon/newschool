<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NewSchool</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <Version>1.0.0</Version>
    <!-- 실행 파일 속성 창에 뜨는 정보. 비워 두면 LegalCopyright 가 빈 문자열이 되어
         배포 바이너리에 저작권 표시가 아예 없다. Company 는 설치 파일의
         AppPublisher(Installer\NewSchoolSetup.iss)와 같은 이름으로 맞춘다. -->
    <Product>NewSchool</Product>
    <!-- Win32 리소스의 FileDescription 은 Description 이 아니라 AssemblyTitle 에서 온다
         (작업 관리자에 뜨는 이름). 둘 다 적어 두어야 양쪽이 채워진다. -->
    <AssemblyTitle>교사를 위한 학급 경영 도우미</AssemblyTitle>
    <Description>교사를 위한 학급 경영 도우미</Description>
    <Company>Centwon</Company>
    <Authors>Centwon</Authors>
    <Copyright>Copyright © 2026 Centwon</Copyright>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>

    <!-- .editorconfig 의 코드 스타일 규칙을 빌드에서도 검사한다.
         이걸 켜기 전에는 규칙이 적혀 있어도(csharp_style_namespace_declarations = file_scoped)
         IDE 안에서만 보여, 저장소의 절반(59개 파일)이 규칙을 어긴 채 쌓여 있었다.
         빌드 경고 0 을 지키는 한, 이제 어긋난 파일은 들어올 수 없다. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- 위를 켜면 "IDE0005(안 쓰는 using)를 검사하려면 GenerateDocumentationFile 을 켜라" 는
         권유가 경고로 올라온다. 그 권유는 따르지 않는다 — XML 문서 파일은 배포물에 들어가는
         군더더기이고(설치 파일 정리 규칙이 하나 늘어난다), 안 쓰는 using 은 IDE 가 이미
         알려 준다. 규칙 자체가 아니라 권유이므로 이것만 끈다. -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>

    <!-- MSB3277: WindowsAppSDK 메타패키지가 전이적으로 끌고 오는 Microsoft.Web.WebView2 패키지가
         net6.0-windows/net8.0-windows TFM에는 Microsoft.Web.WebView2.Wpf.dll을 아예 배포하지 않아,
         NuGet이 유일하게 그 어셈블리를 가진 net5.0-windows(WPF의 WindowsBase 5.0.0.0 참조) 자산으로
         폴백하면서 앱 자체의 WindowsBase(4.0.0.0) 참조와 충돌 경고가 발생한다.
         앱은 WebView2/WPF를 전혀 사용하지 않고(위 "미사용 전이 자산 게시 제외" 참고), 런타임에도
         영향이 없는 빌드 타임 경고이므로 억제한다. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- 테스트 프로젝트에 internal 멤버 노출 (CsvExportService.Escape 등) -->
  <ItemGroup>
    <InternalsVisibleTo Include="NewSchool.Tests" />
  </ItemGroup>

  <!-- 메모리 절약 GC 모드: 힙을 적극 압축·OS 반납해 상주 메모리 축소.
       1~9(클수록 메모리 우선), 이벤트 구동형 앱이라 GC 압력이 낮아 처리량 영향은 미미.
       Native AOT 에서도 runtimeconfig 로 내장되어 동작함. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!-- ==========================================
       빌드 제외 항목
       ========================================== -->
  <ItemGroup>
    <Compile Remove="Board\FileItemBox.xaml.cs" />
    <Compile Remove="Board\PostBox.xaml.cs" />
    <Compile Remove="Board\PostFileListBox.xaml.cs" />
    <!-- 테스트 프로젝트는 별도 csproj 로 빌드되므로 메인 프로젝트의 implicit glob 에서 제외 -->
    <Compile Remove="NewSchool.Tests\**\*.cs" />
    <None Remove="NewSchool.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Board\Controls\FileItemBox.xaml" />
    <None Remove="Board\Controls\PostFileListBox.xaml" />
    <None Remove="Board\FileItemBox.xaml" />
    <None Remove="Board\Pages\PostDetailPage.xaml" />
    <None Remove="Board\Pages\PostEditPage.xaml" />
    <None Remove="Board\Pages\PostListPage.xaml" />
    <None Remove="Board\PostBox.xaml" />
    <None Remove="Board\PostFileListBox.xaml" />
    <None Remove="Controls\MonthPicker.xaml" />
    <None Remove="Controls\SchoolMealBox.xaml" />
    <None Remove="Controls\StudentCard.xaml" />
    <None Remove="Dialogs\SchoolSearchDialog.xaml" />
    <None Remove="Pages\AddStudentsPage.xaml" />
    <None Remove="Pages\StudentInfoExportPage.xaml" />
    <None Remove="Pages\StudentManagementPage.xaml" />
    <None Remove="Pages\TodayPage.xaml" />
    <None Remove="Scheduler\DayCell.xaml" />
    <None Remove="Scheduler\Kcalendar.xaml" />
    <None Remove="SettingsPage.xaml" />
    <None Remove="Pages\InitialSetupWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="Board\FileItemBox.xaml" />
    <Page Remove="Board\PostBox.xaml" />
    <Page Remove="Board\PostFileListBox.xaml" />
  </ItemGroup>

  <!-- ==========================================
       Content 파일 (앱 리소스)
       ========================================== -->
  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- 도움말 HTML (기본 웹 브라우저로 열림 — WebView2 미사용) -->
  <ItemGroup>
    <Content Include="Assets\help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="newschool.ico" />
    <!-- 제3자 라이선스 고지. MIT·Apache-2.0·BSD 계열은 바이너리 배포에도 저작권 문구와
         라이선스 전문을 함께 보낼 것을 요구하므로, 게시 폴더에 실어 설치본과 포터블
         양쪽에 따라가게 한다({app}\bin\ 아래에 놓인다). 지우면 고지가 끊긴다. -->
    <Content Include="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 사용권 계약. 설치 마법사가 동의 페이지로 띄우는 것과 같은 파일이며,
         설치 뒤에도 읽을 수 있도록, 또 마법사를 거치지 않는 포터블에도 닿도록
         게시 폴더 루트에 함께 싣는다(Link 로 Installer\ 를 벗겨 낸다 —
         CleanPublishOutput 이 게시본의 Installer\ 폴더를 통째로 지우기 때문). -->
    <Content Include="Installer\LICENSE_ko.txt" Link="LICENSE_ko.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- secrets.json 은 빌드 시 어셈블리에 내장(EmbeddedResource) → 게시 폴더에 평문 파일을 두지 않음.
         빌드 입력일 뿐이며 .gitignore 로 git 에는 포함되지 않음. -->
    <EmbeddedResource Include="secrets.json" Condition="Exists('secrets.json')" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <None Include="newschool.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- ==========================================
       NuGet 패키지
       ========================================== -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!-- 미사용 전이 의존성(WebView2·Windows AI/ML)의 런타임 자산 게시 제외는
       파일 하단 RemoveUnusedWinAppSdkAssets Target 에서 처리한다(ResolvedFileToPublish 필터). -->

  <!-- WinUIRichEditor: Jodit(WebView2) 대체용 Win2D 네이티브 리치에디터. nuget.org 패키지 참조.
       ⚠ 버전 선택 제약(메커니즘은 그대로 유효): 이 패키지가 선언하는 Microsoft.WindowsAppSDK.WinUI
       하한선이 위 메타패키지가 제공하는 WinUI 를 "넘지 않아야" 한다. 넘으면 NuGet 이 위로 통일하면서
       .Runtime 의 컴포넌트 버전 검사에 걸려 빌드가 실패하고, 이를 피하려 self-contained 로 돌리면
       게시가 9개 → 70개(44MB → 97MB)로 불어난다.
       올리기 전에 반드시 이 조합으로 빌드해 볼 것.
       (아래 0.9.x 기록은 메타패키지가 2.3.1 이던 시절의 것이다: 0.9.1 = 하한선 2.2.1 → 적합,
        0.9.0 = 하한선 2.3.2 → 부적합. 지금 조합은 메타패키지 2.4.0 + 이 패키지 1.1.0 이다.) -->
  <ItemGroup>
    <PackageReference Include="WinUIRichEditor" Version="1.1.0" />
  </ItemGroup>

  <!-- ==========================================
       XAML 컴파일 설정 (Page Update)
       ========================================== -->

  <!-- 모든 XAML 소스 파일 출력 디렉토리 복사 방지 (.xbf 컴파일 버전만 필요) -->
  <ItemGroup>
    <Page Update="**\*.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Page>
    <ApplicationDefinition Update="App.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </ApplicationDefinition>
  </ItemGroup>

  <!-- XAML Generator 설정 -->
  <ItemGroup>
    <Page Update="Board\Controls\PostFileListBox.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Board\Controls\FileItemBox.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Board\Pages\PostEditPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Board\Pages\PostDetailPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Board\Pages\PostListPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Scheduler\UnifiedItemDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Scheduler\DayCell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Scheduler\Kcalendar.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\MonthPicker.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Dialogs\SchoolSearchDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\StudentManagementPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\InitialSetupWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\AddStudentsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\TodayPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Pages\StudentInfoExportPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Scheduler\KAgendaControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\SchoolMealBox.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Controls\StudentCard.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WebView2EnableCsWinRTProjection>False</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- Native AOT 게시. AOT 는 트리밍·self-contained 를 함의하며 ReadyToRun·SingleFile 과 상호배타다.
         → PublishReadyToRun=False 로 명시하고, pubxml 에서 PublishSingleFile 을 끈다. -->
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>True</PublishTrimmed>
    <PublishAot>True</PublishAot>
    <!-- 게시 크기 최적화(저위험): AOT 코드 크기 우선 + 중복 메서드 본문 접기 +
         데스크톱에 불필요한 런타임 기능 스위치 off. 기능/한글 동작에 영향 없음. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- WinAppSDK 를 게시본에 함께 담는다(자체 포함, 1.0.0 부터).
         프레임워크 의존이던 때는 게시 폴더가 9개/44MB 로 작았지만, 설치 프로그램이
         prerequisites\WindowsAppRuntimeInstall-x64.exe(106.9MB)를 함께 안고 다녀야 해서
         **설치 파일이 122.8MB** 였고, 런타임이 없는 PC 에서는 설치 중 별도 단계가 하나 더 붙었다.
         무엇보다 "번들 런타임 2.3 vs 앱 요구 2.4" 같은 불일치가 깨끗한 PC 에서 앱을 아예
         띄우지 못하게 만든 적이 있다(1.0.0 게시가 한 번 막혔던 이유).
         자체 포함으로 바꾸면 런타임이 게시 폴더로 들어와 파일 수는 늘지만
         (CleanPublishOutput 이 ko/en 외 .mui 를 걷어내 70개 안팎),
         **설치 파일은 29MB 대로 줄고 런타임 설치 단계가 통째로 사라진다.**
         전제: 메타패키지 Microsoft.WindowsAppSDK 참조 + 전이 참조들의 WinUI 하한선이
         메타패키지가 주는 WinUI(2.3.1 → 2.3.0)를 넘지 않을 것. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest></ApplicationManifest>
    <ApplicationIcon>newschool.ico</ApplicationIcon>
    <PackageIcon>newschool.png</PackageIcon>
    <!-- Release 게시 시 PDB 제외 (123MB 절약) -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- AOT/트리밍 안전망: MiniExcel·QuestPDF 는 트림 경고(IL2104)를 내므로 전체를 루트로 보존해
       리플렉션으로 접근하는 내부 멤버가 잘려나가 런타임에 깨지는 것을 방지한다.
       (IL3050 동적코드 위험은 ReportExportService 의 동기 SaveAs 전환으로 별도 해소함) -->
  <ItemGroup Condition="'$(PublishAot)' == 'True'">
    <TrimmerRootAssembly Include="MiniExcel" />
    <TrimmerRootAssembly Include="QuestPDF" />
  </ItemGroup>

  <!-- ==========================================
       게시 시 불필요한 파일 출력 제외
       ========================================== -->
  <ItemGroup>
    <!-- 문서 파일 (.md) 제외 — 개발용 문서, 배포 불필요 -->
    <Content Remove="**\*.md" />
    <None Remove="**\*.md" />

    <!-- Docs 디렉토리 전체 제외 -->
    <Content Remove="Docs\**" />
    <None Remove="Docs\**" />

    <!-- .gitignore 제외 -->
    <Content Remove=".gitignore" />
    <None Remove=".gitignore" />

    <!-- Inno Setup 스크립트 출력 제외 -->
    <Content Remove="installer.iss" />
    <None Remove="installer.iss" />

    <!-- Properties 디렉토리 출력 제외 (launchSettings, PublishProfiles) -->
    <Content Remove="Properties\launchSettings.json" />
    <Content Remove="Properties\PublishProfiles\**" />
    <None Update="Properties\launchSettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="Properties\PublishProfiles\**">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>

    <!-- app.manifest 출력 제외 -->
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- QuestPDF LatoFont 출력 제외 (~12MB 절약, 코드에서 미사용) -->
  <Target Name="RemoveQuestPdfLaToFont" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(None.Link)' != '' and $([System.String]::new('%(None.Link)').StartsWith('LatoFont'))" />
    </ItemGroup>
  </Target>

  <!-- 게시 폴더에 복사 방지 -->
  <ItemGroup>
    <Content Remove="installer.iss" />
    <Content Remove="prerequisites\**" />
    <None Remove="installer.iss" />
    <None Remove="prerequisites\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Installer\prerequisites\" />
  </ItemGroup>

  <!-- 게시 후 불필요 파일/폴더 정리 -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PublishXamlFiles Include="$(PublishDir)**\*.xaml" />
      <_PublishPdbFiles Include="$(PublishDir)**\*.pdb" />
      <_PublishManifestFiles Include="$(PublishDir)app.manifest" />
      <_PublishGitignoreFiles Include="$(PublishDir).gitignore" />
      <_PublishPropertiesFiles Include="$(PublishDir)Properties\**\*" />
      <_PublishInstallerFiles Include="$(PublishDir)Installer\**\*" />
      <_PublishPrereqFiles Include="$(PublishDir)prerequisites\**\*" />
      <!-- 개발용/내장 전환된 파일은 게시 폴더에 두지 않음(이전 게시 잔존분도 제거) -->
      <_PublishEditorConfig Include="$(PublishDir).editorconfig" />
      <_PublishSecretsJson Include="$(PublishDir)secrets.json" />

      <!--
        자체 포함(WindowsAppSDKSelfContained=true) 게시본 정리.
        프레임워크 의존 게시본에는 애초에 없는 파일들이라 그때는 조용히 넘어간다.

        ① .winmd — WinRT 메타데이터. Native AOT 는 프로젝션을 실행 파일에 내장하므로
           런타임에 읽지 않는다. 44개나 되어 파일 수의 40%를 차지했다.
        ② 안 쓰는 언어 리소스 — `.mui` 필터가 접두어(StartsWith)라 kok-IN(콘칸어)·en-GB 가
           함께 통과한다. 이 앱은 ko-KR·en-us 만 쓴다.
        ③ 앱에 없는 기능의 컴포넌트 — Windows 검색 통합·위젯·NPU/AI 추론.
        ④ qpdf — QuestPDF 부속이지만 **문서 병합·PDF/A 전용**이다. 이 앱은 GeneratePdf 만
           쓰고 QuestPDF.Qpdf 경로를 타지 않는다(렌더링은 QuestPdfSkia.dll 이 한다 — 지우지 말 것).
        ⑤ Bootstrap — 프레임워크 패키지를 찾아 주는 역할이라 자체 포함에서는 쓰이지 않는다.

        ⚠ MS 가 보증하는 구성이 아니다. WinAppSDK 를 올릴 때마다 아래 스모크를 다시 볼 것 —
          PDF 출력(좌석·학생카드·누가기록) · 리치에디터 · 엑셀 내보내기 · 구글 연동 · 인쇄.
      -->
      <_PublishWinmdFiles Include="$(PublishDir)*.winmd" />
      <_PublishUnusedLocaleDirs Include="kok-IN;en-GB" />
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.Windows.Search.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.Windows.Widgets.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)PerceptiveStreaming.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)NPUDetect.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.Windows.Workloads*" />
      <_PublishUnrelatedNative Include="$(PublishDir)qpdf.dll" />
      <!--
        ⑥ 어디에서도 닿지 않는 나머지.
        고른 근거: dumpbin -dependents 로 게시본 35개 PE 의 역참조 표를 만들고,
        NewSchool.exe 안에 박혀 있는 regfree-COM 매니페스트(<asmv3:file> 27줄 — 자체 포함
        게시에서 WinRT 활성화가 실제로 참조하는 유일한 목록)와 대조했다.
        아래 것들은 (ㄱ) 매니페스트에 없거나, (ㄴ) 있더라도 그 클래스를 부르는 코드가 앱에 없고,
        (ㄷ) 남는 어떤 파일도 정적으로 임포트하지 않는다. 합계 약 0.5MB.

        · Microsoft.UI.Designer.dll — DesignerOutputHost 하나뿐이다. Visual Studio 의 XAML
          디자이너가 띄우는 것이라 배포된 앱은 활성화할 일이 없다.
        · Microsoft.Graphics.Imaging.dll — Windows AI 의 ImageBuffer 네이티브. 투영
          (Microsoft.Graphics.Imaging.Projection)은 이미 아래 Target 에서 빠져 있어 도달 경로가 없다.
        · SessionHandleIPCProxyStub.dll — Windows AI 세션 핸들 COM 프록시/스텁.
          Microsoft.Windows.AI.* 가 전부 빠진 뒤로는 부를 쪽이 없다.
        · PushNotificationsLongRunningTask.ProxyStub.dll — 푸시 알림 COM 프록시.
          매니페스트에 실려 있지도 않고, 앱은 푸시 알림 API 를 쓰지 않는다.
        · UniversalBGTask.dll — BackgroundTaskBuilder 가 이름으로 부르는 백그라운드 작업 호스트.
          앱에 백그라운드 작업이 없다(매니페스트에도 없어 활성화 자체가 불가능하다).

        ⚠ RestartAgent.exe 는 지우지 말 것 — App.xaml.cs 의 AppInstance.Restart 가 쓴다.
        ⚠ Microsoft.UI.Xaml.Phone.dll 도 지우지 말 것 — Pivot·DatePicker·TimePickerFlyout·
          네비게이션 전환이 전부 여기 있고 앱이 모두 쓴다(ko-KR/en-us 의 .mui 도 함께 유지).
      -->
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.UI.Designer.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.Graphics.Imaging.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)SessionHandleIPCProxyStub.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)PushNotificationsLongRunningTask.ProxyStub.dll" />
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" />
      <!-- ⑦ 읽는 쪽이 이미 사라진 데이터 파일.
           · workloads*.json — NPU 워크로드 목록. 읽는 Microsoft.Windows.Workloads.dll 을 ③에서
             지웠으므로 아무도 열지 않는 파일만 6개 남는다.
           · Microsoft.UI.Xaml\Assets\map.html — MapControl 이 WebView2 로 띄우는 지도 문서.
             앱은 MapControl 을 쓰지 않고 WebView2 자체가 빠져 있다.
             (같은 폴더의 NoiseAsset_256x256_PNG.png 는 AcrylicBrush 가 쓴다 — 지우지 말 것.) -->
      <_PublishOrphanData Include="$(PublishDir)workloads*.json" />
      <_PublishOrphanData Include="$(PublishDir)Microsoft.UI.Xaml\Assets\map.html" />
      <!-- ⚠ 부트스트래퍼는 **자체 포함일 때만** 뺀다. 프레임워크 의존 게시본에서 지우면
           프레임워크 패키지를 찾지 못해 앱이 시작조차 못 한다. -->
      <_PublishUnrelatedNative Include="$(PublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll"
                              Condition="'$(WindowsAppSDKSelfContained)' == 'true'" />
    </ItemGroup>
    <Delete Files="@(_PublishXamlFiles)" />
    <Delete Files="@(_PublishPdbFiles)" />
    <Delete Files="@(_PublishManifestFiles)" />
    <Delete Files="@(_PublishGitignoreFiles)" />
    <Delete Files="@(_PublishPropertiesFiles)" />
    <Delete Files="@(_PublishInstallerFiles)" />
    <Delete Files="@(_PublishPrereqFiles)" />
    <Delete Files="@(_PublishEditorConfig)" />
    <Delete Files="@(_PublishSecretsJson)" />
    <Delete Files="@(_PublishWinmdFiles)" />
    <Delete Files="@(_PublishUnrelatedNative)" />
    <Delete Files="@(_PublishOrphanData)" />
    <RemoveDir Directories="@(_PublishUnusedLocaleDirs->'$(PublishDir)%(Identity)')" />
    <RemoveDir Directories="$(PublishDir)Properties" />
    <RemoveDir Directories="$(PublishDir)Pages" />
    <RemoveDir Directories="$(PublishDir)Controls" />
    <RemoveDir Directories="$(PublishDir)Dialogs" />
    <RemoveDir Directories="$(PublishDir)Board" />
    <RemoveDir Directories="$(PublishDir)Scheduler" />
    <RemoveDir Directories="$(PublishDir)Installer" />
    <RemoveDir Directories="$(PublishDir)prerequisites" />
    <Message Text="[CleanPublishOutput] 불필요 파일/폴더 정리 완료" Importance="high" />
  </Target>

  <!-- ==========================================
       미사용 전이 자산 게시 제외 (WindowsAppSDK 가 끌고 오는 WebView2·Windows AI(ML))
       앱은 WebView2(Jodit 제거)·Windows AI/ML 을 사용하지 않음 → 게시본에서 제거.
       · managed projection(WebView2·Microsoft.Windows.AI.*·Imaging) ~2MB
       · 네이티브 ML 런타임(onnxruntime.dll 20.7MB + DirectML.dll 17.8MB) ~38MB
       SingleFile/AOT 모두 번들 전 단계인 ResolvedFileToPublish 에서 걸러야 한다
       (게시 후 Delete 로는 exe 번들 내부를 못 지움).
       ⚠ Win2D(Microsoft.Graphics.Canvas*)는 WinUIRichEditor 가 사용 → 유지.
       ⚠ 게시 후 실행 검증 필요(앱 시작·도움말·Google/NEIS). 문제 시 이 Target 제거로 즉시 원복.
       ========================================== -->
  <Target Name="RemoveUnusedWinAppSdkAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2'))&#xD;&#xA;                  or '%(Filename)' == 'WebView2Loader'&#xD;&#xA;                  or '%(Filename)' == 'Microsoft.ML.OnnxRuntime'&#xD;&#xA;                  or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI'))&#xD;&#xA;                  or '%(Filename)' == 'Microsoft.Graphics.Imaging.Projection'&#xD;&#xA;                  or '%(Filename)' == 'onnxruntime'&#xD;&#xA;                  or '%(Filename)' == 'DirectML'" />
      <!-- WinUI 다국어 리소스(.mui) 중 ko/en 외 제거 — 안전망.
           프레임워크 의존(현재 기본)에서는 .mui 가 설치된 런타임에 있어 게시 폴더에 오지 않으므로
           이 필터는 동작하지 않는다. self-contained 로 전환하면 WinAppSDK 의 ~85개 언어 폴더
           (af-ZA … zh-TW)가 딸려오는데, 한국어 앱이라 ko-KR 만 있으면 충분하고 미매칭 언어는
           DLL 내장 영문으로 폴백하므로 en 만 함께 남긴다(그 경우 ~84개 폴더·3.4MB 절약). -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.mui'&#xD;&#xA;                  and !$([System.String]::Copy('%(RelativePath)').StartsWith('ko'))&#xD;&#xA;                  and !$([System.String]::Copy('%(RelativePath)').StartsWith('en'))" />
    </ItemGroup>
  </Target>
</Project>
