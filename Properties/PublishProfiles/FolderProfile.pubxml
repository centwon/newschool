<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Installer\NewSchoolSetup.iss 의 PublishDir 과 같은 곳이어야 한다.
         VS "게시" 버튼이 쓰는 프로필이 여기인데 예전 기본값(bin\Release\Publish)이
         남아 있어, 게시를 새로 해도 설치 파일에는 옛 게시본이 담겼다.
         win-x64.pubxml·SDK 기본값과 같은 식으로 맞춘다 — RuntimeIdentifier 뒤에 두어야
         $(RuntimeIdentifier) 가 채워진 상태로 펼쳐진다. -->
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <!-- Native AOT 게시: SingleFile·ReadyToRun 은 AOT 와 상호배타라 끈다.
         AOT 산출물은 네이티브 exe + 소수 네이티브 dll 형태(단일파일 아님). -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishAot>true</PublishAot>
    <!-- PDB 제외 (123MB 절약) -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>