<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NewSchool.Pages.CourseSectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.Resources>
            <Flyout x:Name="ImportConfirmFlyout">
                <StackPanel Spacing="12" Width="300">
                    <TextBlock x:Name="TxtImportConfirm" Text="" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="취소" Click="OnImportCancelClick"/>
                        <Button Content="가져오기" Style="{StaticResource AccentButtonStyle}" Click="OnImportConfirmClick"/>
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 제목 -->
            <RowDefinition Height="Auto"/>
            <!-- 도구 모음 -->
            <RowDefinition Height="Auto"/>
            <!-- 헤더 행 -->
            <RowDefinition Height="*"/>
            <!-- 단원 목록 -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 통계 -->
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button Click="OnBackClick" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="수업 관리"/>
                </StackPanel>
            </Button>
            <TextBlock Text="단원 관리" FontSize="28" FontWeight="Bold"/>
            <TextBlock x:Name="TxtCourseInfo"
                       FontSize="14"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,6"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 도구 모음 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnImportCsv" Click="OnImportCsvClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                    <TextBlock Text="CSV 가져오기"/>
                </StackPanel>
            </Button>
            <Button Click="OnExportCsvClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14"/>
                    <TextBlock Text="CSV 내보내기"/>
                </StackPanel>
            </Button>
            <Button Click="OnDownloadTemplateClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                    <TextBlock Text="템플릿 다운로드"/>
                </StackPanel>
            </Button>
            <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="8,4"/>
            <Button x:Name="BtnAddSection" Click="OnAddSectionClick" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="소단원 추가"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnClearAll" Click="OnClearAllClick">
                <Button.Flyout>
                    <Flyout x:Name="ClearAllFlyout">
                        <StackPanel Spacing="12" Width="250">
                            <TextBlock x:Name="TxtClearConfirm" Text="모든 단원을 삭제하시겠습니까?" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="취소" Click="OnClearAllCancelClick"/>
                                <Button Content="삭제" Style="{StaticResource AccentButtonStyle}" Click="OnClearAllConfirmClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    <TextBlock Text="전체 삭제"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 단원 목록 헤더 -->
        <Grid x:Name="SectionListHeader"
              Grid.Row="2"
              Visibility="Collapsed"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              Padding="8,6"
              ColumnSpacing="8"
              CornerRadius="4,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="연번" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="단원번호" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="소단원명" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="페이지" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="시수" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- 단원 목록 -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="0,0,4,4">
            <Grid>
                <StackPanel x:Name="SectionEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="등록된 단원이 없습니다"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="CSV 파일을 가져오거나 소단원을 추가하세요"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <ListView x:Name="SectionListView"
                          Visibility="Collapsed"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnSectionItemClick"
                          CanDragItems="True"
                          CanReorderItems="True"
                          AllowDrop="True"
                          ReorderMode="Enabled"
                          DragItemsCompleted="OnSectionDragCompleted"
                          ContainerContentChanging="OnSectionContainerContentChanging"
                          Margin="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CourseSection">
                            <Grid Padding="8,4" ColumnSpacing="8" ToolTipService.ToolTip="클릭하여 편집">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 연번 (ContainerContentChanging 에서 채움) -->
                                <TextBlock Grid.Column="0"
                                           Text=""
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind FullPath}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind SectionName}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind PageRangeDisplay}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind HoursDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="5"
                                        Click="OnDeleteSectionClick"
                                        Tag="{x:Bind}"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 하단 통계 -->
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock x:Name="TxtSectionStatistics"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <InfoBar x:Name="SectionErrorInfoBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True"/>
        </StackPanel>
    </Grid>
</Page>
