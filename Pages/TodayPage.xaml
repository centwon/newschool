<Page
    x:Class="NewSchool.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:NewSchool.Pages"
    xmlns:models="using:NewSchool.Models"
    xmlns:vm="using:NewSchool.ViewModels"
    xmlns:controls="using:NewSchool.Controls"
    xmlns:scheduler="using:NewSchool.Scheduler"
    xmlns:board="using:NewSchool.Board.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    Loaded="Page_Loaded" >

    <Grid Padding="16,8,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ 상단: 날짜 이동 · 그날 학사일정 · 현재 교시 ═══ -->
        <Border Grid.Row="0" Style="{StaticResource DashboardCard}" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!--
                    날짜를 옮기면 <b>내 수업 · 우리 반 · 급식 · 그날 행사</b>만 따라온다.
                    학사일정 목록·할 일·메모는 원래 "앞으로"를 보는 카드라 그대로 둔다 —
                    그래서 오늘이 아닐 때는 무엇이 그 날짜인지 안내를 함께 띄운다.
                    달력 선택기는 두지 않는다: 며칠 뒤를 한눈에 보는 일은
                    [주별 시간표 확인 및 변경] 탭이 3주치로 이미 답한다.
                -->
                <Button Click="OnPreviousDayClick" Padding="6,2"
                        AutomationProperties.Name="하루 앞으로" ToolTipService.ToolTip="하루 앞으로">
                    <FontIcon Glyph="&#xE76B;" FontSize="11"/>
                </Button>

                <TextBlock x:Name="TxtTodayDate"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTodayDow"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <Button Click="OnNextDayClick" Padding="6,2"
                        AutomationProperties.Name="하루 뒤로" ToolTipService.ToolTip="하루 뒤로">
                    <FontIcon Glyph="&#xE76C;" FontSize="11"/>
                </Button>

                <Button x:Name="BtnBackToToday"
                        Content="오늘"
                        Click="OnBackToTodayClick"
                        Visibility="Collapsed"/>

                <TextBlock x:Name="TxtTodayEvent"
                           FontSize="13" VerticalAlignment="Center"
                           MaxWidth="360" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"/>

                <Border x:Name="CurrentPeriodBadge"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentPeriod"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                </Border>

                <!-- 오늘이 아닐 때: 어느 카드가 이 날짜인지 알린다 -->
                <TextBlock x:Name="TxtOtherDayNotice"
                           FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Text="오늘이 아닙니다 — 내 수업·우리 반·급식·행사만 이 날짜입니다."/>
            </StackPanel>
        </Border>

        <!-- ═══ 메인 콘텐츠 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 패널: 시간표, 학사일정, 급식 -->
            <Grid RowSpacing="12" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 시간표 카드 + 그 아래 알림 줄 (닫혀 있으면 자리를 차지하지 않는다) -->
                <StackPanel Grid.Row="0">
                <!-- 시간표 카드: 내 수업 | 우리 반 (한 줄 = 한 교시) -->
                <Border Style="{StaticResource DashboardCard}">
                    <Grid x:Name="TimetableTable">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="ClassColumn" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 헤더: 내 수업 -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource DashboardCardHeader}"
                                CornerRadius="7,0,0,0" Padding="10,7">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D3;" Style="{StaticResource DashboardCardHeaderIcon}" FontSize="14"/>
                                <TextBlock Text="내 수업" Style="{StaticResource DashboardCardHeaderTitle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- 헤더: 우리 반 -->
                        <Border x:Name="ClassHeaderCell" Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource DashboardCardHeader}"
                                CornerRadius="0,7,0,0" Padding="10,7" BorderThickness="1,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;" Style="{StaticResource DashboardCardHeaderIcon}" FontSize="14"/>
                                <TextBlock Text="우리 반" Style="{StaticResource DashboardCardHeaderTitle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!--
                            본문: 한 줄 = 한 교시. 왼쪽 내 수업 · 오른쪽 우리 반이 같은 교시를 가리킨다.
                            공강도 빈 줄로 둔다 — 그 줄을 눌러 보강·대강을 넣는다.
                        -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" MinHeight="56">
                            <TextBlock x:Name="TxtNoSlots" Text="수업 없음"
                                       HorizontalAlignment="Center" Margin="0,12" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsControl x:Name="PeriodRowsList" Padding="4,4,4,8" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TodayPeriodRow">
                                        <Grid Margin="4,1" MinHeight="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="{x:Bind ClassColumnWidth}"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 현재 교시 강조 배경 (두 열에 걸쳐) -->
                                            <Border Grid.ColumnSpan="2" CornerRadius="5"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind local:TodayPage.ShowIfNow(IsCurrentPeriod), Mode=OneWay}"/>

                                            <!--
                                                내 수업 칸이 단추다 — 누르면 수업 홈 시간표와 같은 칸 메뉴
                                                (수업 일지 · 진도 완료 표시 · 수업 변경)가 뜬다.
                                                배경을 투명으로 둬서 생김새는 그대로 두고 눌림·포커스만 얹는다.
                                            -->
                                            <Button Grid.Column="0" MinHeight="22" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Tag="{x:Bind}"
                                                    AutomationProperties.Name="{x:Bind local:TodayPage.SlotName(Period, Subject, Room)}"
                                                    ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                    Click="TeacherSlot_Click">
                                                <Grid ColumnSpacing="6" Padding="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                            CornerRadius="4" Padding="0,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Period}" FontSize="11" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                                                    </Border>
                                                    <!--
                                                        변경 배지(휴강·교체·보강·대강)는 두지 않는다 — 과목명 앞의
                                                        표식이 (휴)·(교)·(보)·(대) 로 같은 말을 이미 하고 있다.
                                                        변경 사유 메모는 줄의 툴팁에 있다.
                                                    -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Subject}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Opacity="{x:Bind local:TodayPage.DimIfCancelled(IsCancelled)}"
                                                                   TextDecorations="{x:Bind local:TodayPage.StrikeIfCancelled(IsCancelled)}"/>
                                                        <TextBlock Text="{x:Bind Room}" FontSize="12"
                                                                   Opacity="{x:Bind local:TodayPage.DimIfCancelled(IsCancelled)}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <!-- 일지를 써 둔 교시 — 수업 홈 시간표의 공책 표시와 같다 -->
                                                        <FontIcon Glyph="&#xE70B;" FontSize="11" VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                  Visibility="{x:Bind local:TodayPage.ShowIfNow(HasJournal)}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>

                                            <!-- 우리 반 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                        Padding="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ClassSubject}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind ClassTeacher}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- '지금' 배지 (오버레이, 줄의 오른쪽 끝) -->
                                            <Border Grid.ColumnSpan="2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                                    CornerRadius="7" Padding="5,1" IsHitTestVisible="False"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind local:TodayPage.ShowIfNow(IsCurrentPeriod), Mode=OneWay}">
                                                <TextBlock Text="지금" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 칸 메뉴로 한 일의 확인·실패 (진도 표시처럼 눈에 안 보이는 동작) -->
                <InfoBar x:Name="SlotInfoBar" Margin="0,8,0,0" IsOpen="False" IsClosable="True"/>
                </StackPanel>

                <!-- 학사일정 카드 -->
                <controls:SchoolScheduleListControl x:Name="ScheduleList" Grid.Row="1"/>

                <!-- 급식 카드 -->
                <controls:SchoolMealBox x:Name="MealBox" Grid.Row="2"/>
            </Grid>

            <!-- 우측 패널: 할 일 목록 + 메모보드 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="270"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 할 일 + 일정 통합 카드 -->
                <scheduler:KAgendaControl Grid.Row="0"
                            x:Name="AgendaList"
                            Background="Transparent"/>

                <!-- 메모보드 컨텐츠 -->
                <board:MemoBoard Grid.Row="2"
                        x:Name="MemoBoard"
                        ShowFilter="True"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
