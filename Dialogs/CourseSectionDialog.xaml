<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NewSchool.Dialogs.CourseSectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NewSchool.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Dialog"
    Title="소단원 편집"
    PrimaryButtonText="저장"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
        <StackPanel Spacing="16" Width="600" Padding="4">
            <!-- 과목 정보 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TxtCourseName"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCourseInfo"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 대단원 -->
            <StackPanel Spacing="6">
                <TextBlock Text="대단원" FontSize="13" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="NumUnitNo" 
                               Grid.Column="0"
                               Header="번호"
                               Width="100" 
                               Minimum="0" 
                               Maximum="20" 
                               Value="1" 
                               SpinButtonPlacementMode="Compact"/>
                    <TextBox x:Name="TxtUnitName" 
                             Grid.Column="1"
                             Header="대단원명"
                             PlaceholderText="예) 수와 연산"/>
                </Grid>
            </StackPanel>

            <!-- 중단원 -->
            <StackPanel Spacing="6">
                <TextBlock Text="중단원" FontSize="13" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="NumChapterNo" 
                               Grid.Column="0"
                               Header="번호"
                               Width="100" 
                               Minimum="0" 
                               Maximum="20" 
                               Value="1" 
                               SpinButtonPlacementMode="Compact"/>
                    <TextBox x:Name="TxtChapterName" 
                             Grid.Column="1"
                             Header="중단원명"
                             PlaceholderText="예) 자연수의 혼합 계산"/>
                </Grid>
            </StackPanel>

            <!-- 소단원 -->
            <StackPanel Spacing="6">
                <TextBlock Text="소단원 *" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="NumSectionNo" 
                               Grid.Column="0"
                               Header="번호"
                               Width="100" 
                               Minimum="1" 
                               Maximum="50" 
                               Value="1" 
                               SpinButtonPlacementMode="Compact"/>
                    <TextBox x:Name="TxtSectionName" 
                             Grid.Column="1"
                             Header="소단원명 (필수)"
                             PlaceholderText="예) 덧셈과 뺄셈의 혼합 계산"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 차시·페이지 -->
            <Grid ColumnSpacing="12" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 예상 차시 -->
                <NumberBox x:Name="NumEstimatedHours"
                           Grid.Column="0" Grid.Row="0"
                           Header="예상 차시"
                           Minimum="1" 
                           Maximum="20" 
                           Value="1" 
                           SpinButtonPlacementMode="Compact"/>

                <!-- 시작 페이지 -->
                <NumberBox x:Name="NumStartPage" 
                           Grid.Column="0" Grid.Row="1"
                           Header="시작 페이지"
                           Minimum="0" 
                           Maximum="500" 
                           Value="0" 
                           SpinButtonPlacementMode="Compact"/>

                <!-- 끝 페이지 -->
                <NumberBox x:Name="NumEndPage" 
                           Grid.Column="1" Grid.Row="1"
                           Header="끝 페이지"
                           Minimum="0" 
                           Maximum="500" 
                           Value="0" 
                           SpinButtonPlacementMode="Compact"/>
            </Grid>

            <!-- 오류 메시지 -->
            <InfoBar x:Name="ErrorInfoBar"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
