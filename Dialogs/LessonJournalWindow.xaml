<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NewSchool.Dialogs.LessonJournalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NewSchool.Controls"
    xmlns:boardcontrols="using:NewSchool.Board.Controls"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d"
    Title="수업 일지">

    <Grid Padding="24,20,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 머리 정보 -->
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="*"/>      <!-- 본문 + 첨부 -->
            <RowDefinition Height="Auto"/>   <!-- 버튼 -->
        </Grid.RowDefinitions>

        <!-- 머리 정보: 날짜 · 교시 · 교과 · 강의실 · 단원 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <CalendarDatePicker x:Name="DpDate"
                                Grid.Column="0"
                                Header="날짜"
                                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                HorizontalAlignment="Stretch"/>

            <ComboBox x:Name="CmbPeriod"
                      Grid.Column="1"
                      Header="교시"
                      HorizontalAlignment="Stretch"/>

            <ComboBox x:Name="CmbCourse"
                      Grid.Column="2"
                      Header="교과"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="CmbCourse_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Course">
                        <TextBlock>
                            <Run Text="{x:Bind Subject}"/>
                            <Run Text="("/><Run Text="{x:Bind Grade}"/><Run Text="학년)"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox x:Name="CmbRoom"
                      Grid.Column="3"
                      Header="강의실"
                      IsEditable="True"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="예: 1-1"/>

            <ComboBox x:Name="CmbSection"
                      Grid.Column="4"
                      Header="단원 (선택)"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="고르면 본문 첫 줄에 들어갑니다"/>
        </Grid>

        <!-- 제목 -->
        <TextBox x:Name="TxtTitle"
                 Grid.Row="1"
                 Header="제목"
                 PlaceholderText="8/21 3교시 영어 1-1"/>

        <!-- 본문 + 첨부 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinHeight="300">
                    <controls:RichTextEditor x:Name="Editor"
                                             Mode="Full"
                                             MinHeight="280"/>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="📎 첨부파일"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            MinHeight="80"
                            Padding="8">
                        <boardcontrols:PostFileListBox x:Name="FileList"
                                                       AllowDrop="True"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 하단: 안내 + 버튼 -->
        <Grid Grid.Row="3">
            <TextBlock x:Name="TxtHint"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="BtnSave"
                        Content="저장"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="90"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel"
                        Content="취소"
                        MinWidth="90"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
