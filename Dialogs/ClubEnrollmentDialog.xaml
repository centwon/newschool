<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NewSchool.Dialogs.ClubEnrollmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NewSchool.Controls"
    mc:Ignorable="d"
    Title="부원 관리"
    PrimaryButtonText="저장"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Loaded="OnLoaded">

    <!-- ⚠ 이 두 값이 있어야 학생 목록에 스크롤바가 생긴다.
         높이를 묶어 두지 않으면 안쪽 ListView 가 "높이 무한" 으로 측정돼 항목을 전부 펼치고,
         스크롤이 필요 없다고 판단해 스크롤바를 그리지 않는다 — 목록이 길어져도 더 있는 줄
         알 수 없었다. 같은 모양의 수업 배정 다이얼로그에는 처음부터 있었다. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="1000" MinHeight="550">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 에러/안내 메시지 -->
        <InfoBar x:Name="InfoMessage"
                 Grid.Row="0"
                 IsOpen="False"
                 IsClosable="True"
                 Margin="0,0,0,8"/>

        <!-- 동아리 정보 헤더 -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE902;" FontSize="16" 
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtClubName"
                                   Text="동아리명"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtActivityRoom"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="TxtEnrolledCount"
                           Text="부원: 0명"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 학생 목록 영역 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 좌측: 등록 가능한 학생 ========== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="12,8"
                        CornerRadius="8,8,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,0">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE716;" FontSize="14"/>
                        <TextBlock Text="등록 가능한 학생"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="8,0,0,0"/>
                        <TextBlock x:Name="TxtAvailableCount"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 필터 -->
                <Grid Grid.Row="1" 
                      Padding="8"
                      ColumnSpacing="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 항목은 BuildFiltersFromRoster 가 명부에서 채운다.
                         반 필터와 같은 규칙으로 두려는 것이다 — 한쪽만 여기 적어 두면
                         학년은 늘 셋, 반은 명부대로가 되어 두 칸이 서로 다른 말을 한다. -->
                    <ComboBox x:Name="CBoxGradeFilter"
                              Grid.Column="0"
                              Header="학년"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CBoxGradeFilter_SelectionChanged"/>

                    <ComboBox x:Name="CBoxClassFilter"
                              Grid.Column="1"
                              Header="반"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CBoxClassFilter_SelectionChanged"/>
                </Grid>

                <!-- 학생 목록 -->
                <controls:ListStudent x:Name="ListAvailable"
                                      Grid.Row="2"
                                      ViewMode="NumName"
                                      ShowCheckBox="True"
                                      MinWidth="250"/>
            </Grid>

            <!-- ========== 중앙: 이동 버튼 ========== -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0">
                <Button x:Name="BtnAdd"
                        Click="BtnAdd_Click"
                        AutomationProperties.Name="선택한 학생 등록" ToolTipService.ToolTip="선택한 학생 등록"
                        Padding="12,8"
                        Margin="0,4">
                    <FontIcon Glyph="&#xE72A;" FontSize="16"/>
                </Button>
                <Button x:Name="BtnRemove"
                        Click="BtnRemove_Click"
                        AutomationProperties.Name="선택한 학생 등록 해제" ToolTipService.ToolTip="선택한 학생 등록 해제"
                        Padding="12,8"
                        Margin="0,4">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- ========== 우측: 등록된 부원 ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="12,8"
                        CornerRadius="8,8,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,0">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE77B;" FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="등록된 부원"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="8,0,0,0"/>
                        <TextBlock x:Name="TxtRegisteredCount"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 검색 -->
                <TextBox x:Name="TxtSearch"
                         Grid.Row="1"
                         PlaceholderText="이름 검색..."
                         Margin="8"
                         TextChanged="TxtSearch_TextChanged"
                         Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>

                <!-- 등록 학생 목록 -->
                <controls:ListStudent x:Name="ListEnrolled"
                                      Grid.Row="2"
                                      ViewMode="ClassNumName"
                                      ShowCheckBox="True"
                                      MinWidth="250"/>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
