<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NewSchool.Dialogs.StudentEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="학생 정보"
    PrimaryButtonText="저장"
    CloseButtonText="취소"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="14" Padding="4" MinWidth="420">

            <!-- 에러 메시지 컨테이너 -->
            <StackPanel x:Name="ErrorContainer"/>

            <!-- 학생 ID (수정 시에만) -->
            <TextBlock x:Name="TxtStudentId"
                       Visibility="Collapsed"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- 이름 · 성별 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="TxtName"
                         Header="이름 *"
                         MaxLength="30"/>

                <ComboBox Grid.Column="1"
                          x:Name="CBoxSex"
                          Header="성별 *"
                          PlaceholderText="선택"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="남" Tag="남"/>
                    <ComboBoxItem Content="여" Tag="여"/>
                </ComboBox>
            </Grid>

            <!-- 학년도 · 학년 · 반 · 번호 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <NumberBox Grid.Column="0" x:Name="NumYear"   Header="학년도 *" Minimum="1900" Maximum="2200" SpinButtonPlacementMode="Hidden"/>
                <NumberBox Grid.Column="1" x:Name="NumGrade"  Header="학년 *"   Minimum="1"    Maximum="12"   SpinButtonPlacementMode="Compact"/>
                <NumberBox Grid.Column="2" x:Name="NumClass"  Header="반 *"     Minimum="1"    Maximum="99"   SpinButtonPlacementMode="Compact"/>
                <NumberBox Grid.Column="3" x:Name="NumNumber" Header="번호 *"   Minimum="1"    Maximum="99"   SpinButtonPlacementMode="Compact"/>
            </Grid>

            <!-- 학적 변동 · 변동일자 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- 유형이 명단 포함 여부를 정한다. 괄호 안에 결과를 적어 두어야
                     고르는 사람이 "이걸 고르면 명단에서 빠지는구나" 를 안다. -->
                <ComboBox Grid.Column="0"
                          x:Name="CBoxChange"
                          Header="학적 변동"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnChangeTypeSelectionChanged">
                    <ComboBoxItem Content="입학" Tag="입학"/>
                    <ComboBoxItem Content="진급" Tag="진급"/>
                    <ComboBoxItem Content="전입" Tag="전입"/>
                    <ComboBoxItem Content="전출 — 명단에서 빠짐" Tag="전출"/>
                    <ComboBoxItem Content="졸업 — 명단에서 빠짐" Tag="졸업"/>
                    <ComboBoxItem Content="휴학 — 명단에서 빠짐" Tag="휴학"/>
                    <ComboBoxItem Content="유예 — 명단에서 빠짐" Tag="유예"/>
                    <ComboBoxItem Content="정원외 — 명단에서 빠짐" Tag="정원외"/>
                    <ComboBoxItem Content="자퇴 — 명단에서 빠짐" Tag="자퇴"/>
                    <ComboBoxItem Content="퇴학 — 명단에서 빠짐" Tag="퇴학"/>
                </ComboBox>

                <CalendarDatePicker Grid.Column="1"
                                    x:Name="DateChange"
                                    Header="변동일자"
                                    PlaceholderText="날짜 선택"
                                    HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- 고른 값이 무엇을 뜻하는지 한 줄로 되비쳐 준다. -->
            <TextBlock x:Name="TxtChangeHint"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- 비고 -->
            <TextBox x:Name="TxtMemo"
                     Header="비고"
                     PlaceholderText="전입·전출 학교명이나 사유를 적는 자리이기도 합니다"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
