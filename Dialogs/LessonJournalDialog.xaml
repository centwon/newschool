<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NewSchool.Dialogs.LessonJournalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d"
    Title="수업 일지 작성"
    PrimaryButtonText="작성"
    CloseButtonText="취소"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="420">

        <!-- 날짜 · 교시 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CalendarDatePicker x:Name="DpDate"
                                Grid.Column="0"
                                Header="날짜"
                                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                HorizontalAlignment="Stretch"/>

            <ComboBox x:Name="CmbPeriod"
                      Grid.Column="1"
                      Header="교시"
                      Width="110"/>
        </Grid>

        <!-- 교과 -->
        <ComboBox x:Name="CmbCourse"
                  Header="교과"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="CmbCourse_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:Course">
                    <TextBlock>
                        <Run Text="{x:Bind Subject}"/>
                        <Run Text="("/><Run Text="{x:Bind Grade}"/><Run Text="학년)"/>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- 강의실 -->
        <ComboBox x:Name="CmbRoom"
                  Header="강의실"
                  IsEditable="True"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="예: 1-1"/>

        <!-- 단원 (선택) -->
        <StackPanel Spacing="4">
            <ComboBox x:Name="CmbSection"
                      Header="단원 (선택)"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="단원을 고르면 본문 첫 줄에 들어갑니다"/>
            <TextBlock x:Name="TxtSectionHint"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 미리보기 -->
        <StackPanel Spacing="4">
            <TextBlock Text="미리보기" FontSize="12" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="10,8">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtPreviewTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtPreviewBody"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <InfoBar x:Name="ErrorInfoBar"
                 IsOpen="False"
                 Severity="Error"
                 IsClosable="True"/>
    </StackPanel>
</ContentDialog>
