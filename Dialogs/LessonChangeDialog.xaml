<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NewSchool.Dialogs.LessonChangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d"
    Title="앞으로 걸린 수업 변경"
    CloseButtonText="닫기"
    DefaultButton="Close">

    <Grid Width="680" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 안내 -->
            <RowDefinition Height="Auto"/>
            <!-- 목록 머리 -->
            <RowDefinition Height="320"/>
            <!-- 목록 -->
            <RowDefinition Height="Auto"/>
            <!-- 상태 -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="오늘 이후로 등록된 변경을 모두 모아 봅니다. 여기서는 지우기만 합니다 — 넣고 고치는 것은 [주별 시간표 확인 및 변경] 탭에서 직접 합니다."/>

        <!-- 목록 머리 -->
        <Grid Grid.Row="1"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              Padding="12,6"
              ColumnSpacing="8"
              CornerRadius="4,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="날짜" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="교시" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="내용" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="메모" FontSize="12" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="0,0,4,4">
            <Grid>
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <FontIcon Glyph="&#xE787;" FontSize="36"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="앞으로 걸린 변경이 없습니다"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="[주별 시간표 확인 및 변경] 탭에서 그 날 칸을 오른쪽 클릭하면 휴강·교체·보강·대강을 넣을 수 있습니다"
                               FontSize="12"
                               MaxWidth="380"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <ListView x:Name="ChangeListView"
                          Visibility="Collapsed"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LessonChange">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind DateDisplay}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind PeriodDisplay}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ContentDisplay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Memo}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <Button Grid.Column="4"
                                        Click="OnDeleteClick"
                                        Tag="{x:Bind}"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="이 변경 되돌리기"
                                        ToolTipService.ToolTip="이 변경 되돌리기">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <InfoBar x:Name="ChangeInfoBar"
                 Grid.Row="3"
                 IsOpen="False"
                 Severity="Warning"
                 IsClosable="True"/>
    </Grid>
</ContentDialog>
