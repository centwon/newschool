<UserControl
    x:Class="NewSchool.Controls.SchoolMealBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:NewSchool.Models"
    mc:Ignorable="d">

    <Border Style="{StaticResource DashboardCard}" MinHeight="180">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더 — 날짜 선택기는 두지 않는다.
                 날짜는 이 상자를 안고 있는 홈 화면(TodayPage)의 날짜 이동이 정한다.
                 상자가 자기 날짜를 따로 들면 헤더가 말하는 날짜와 급식이 어긋난다. -->
            <Border Grid.Row="0" Style="{StaticResource DashboardCardHeader}" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE957;" Style="{StaticResource DashboardCardHeaderIcon}"/>
                    <TextBlock Text="급식" Style="{StaticResource DashboardCardHeaderTitle}"/>
                </StackPanel>
            </Border>

            <!-- 급식 목록 -->
            <ScrollViewer Grid.Row="1"
                          Padding="12,8,12,12"
                          MaxHeight="300"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="MealsRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="model:SchoolMeal">
                            <StackPanel Spacing="4" Margin="4,0">
                                <!-- 식사 유형 헤더 (조식/중식/석식) -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind MealIcon}" FontSize="13"/>
                                    <TextBlock Text="{x:Bind MMEAL_SC_NM}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <!-- 메뉴 목록 -->
                                <TextBlock Text="{x:Bind MenuText}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="22,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 상자 안 실패 안내는 두지 않는다 — 그것을 띄우던 유일한 경로가
                 "사용자가 상자 안에서 날짜를 바꿨을 때" 였다.
                 실패는 LoadMealsAsync 가 예외로 올려 홈 화면의 전역 InfoBar 로 모인다. -->
        </Grid>
    </Border>
</UserControl>
