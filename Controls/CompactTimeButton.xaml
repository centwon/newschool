<UserControl
    x:Class="NewSchool.Controls.CompactTimeButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <!-- [헤더]
         [시] : [분] [버튼]  — 시/분은 직접 타이핑, 버튼을 누르면 표준 시간 플라이아웃(24시간제)이 뜬다.
         여백 최소·폭은 내용에 맞춤. Header 는 선택(미설정 시 라벨 숨김). -->
    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
        <TextBlock x:Name="HeaderText" Visibility="Collapsed"
                   Margin="1,0,0,4" Foreground="{ThemeResource TextControlHeaderForeground}"/>
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <TextBox x:Name="HourBox" AutomationProperties.Name="시"
                     Width="40" MaxLength="2" InputScope="Number"
                     TextAlignment="Center" Padding="4,4"
                     TextChanged="HourBox_TextChanged" LostFocus="Box_LostFocus"/>
            <TextBlock Text=":" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold" Opacity="0.6" Margin="1,0"/>
            <TextBox x:Name="MinuteBox" AutomationProperties.Name="분"
                     Width="40" MaxLength="2" InputScope="Number"
                     TextAlignment="Center" Padding="4,4"
                     TextChanged="MinuteBox_TextChanged" LostFocus="Box_LostFocus"/>
            <Button x:Name="PickerButton"
                    MinWidth="0" Padding="6,4" Margin="2,0,0,0"
                    AutomationProperties.Name="시간 선택" ToolTipService.ToolTip="시간 선택">
                <FontIcon Glyph="&#xE121;" FontSize="14"/>
                <Button.Flyout>
                    <TimePickerFlyout x:Name="Picker" AutomationProperties.Name="시간 선택"
                                      ClockIdentifier="24HourClock"
                                      TimePicked="Picker_TimePicked"/>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
