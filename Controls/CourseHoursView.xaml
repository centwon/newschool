<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Controls.CourseHoursView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d">

    <!--
        시수 표는 학급 수만큼 열이 늘어나므로 코드에서 만든다.
        색·크기를 코드에 박으면 테마를 바꿔도 그대로 남으므로 스타일로 뺀다.
    -->
    <UserControl.Resources>
        <Style x:Key="HoursHeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,8"/>
        </Style>

        <Style x:Key="HoursCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="HoursHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="HoursTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="HoursMutedTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="HoursTotalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Style>

        <!-- 학급별 시수 입력 칸 -->
        <Style x:Key="HoursInputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 도구 모음 -->
            <RowDefinition Height="Auto"/>
            <!-- 정보 카드 -->
            <RowDefinition Height="*"/>
            <!-- 주차별 표 -->
            <RowDefinition Height="Auto"/>
            <!-- 상태 -->
        </Grid.RowDefinitions>

        <!--
            학기 기간을 고르는 줄은 없앴다 — 학사일정에서 유추한다(방학 앞에서 자른다).
            무엇이 쓰였는지는 학사일정 카드가 알려 준다.
        -->
        <Grid Grid.Row="0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxWidth="640"
                       HorizontalAlignment="Left"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="학사일정의 휴업일·공휴일과 그 학년만 빠지는 행사를 뺀 실제 수업 가능 시수입니다. 학급 칸을 고치면 그 주차만 손으로 정한 값이 됩니다."/>

            <Button AutomationProperties.Name="조정 모두 지우기" x:Name="BtnClearAdjustments"
                    HorizontalAlignment="Right"
                    Click="OnClearAdjustmentsClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                    <TextBlock Text="조정 모두 지우기"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 정보 카드 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 시간표 정보 -->
            <Border Grid.Column="0" Style="{StaticResource InfoCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                        <TextBlock Text="시간표 정보" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPlacementSummary"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto">
                        <StackPanel x:Name="RoomChips" Orientation="Horizontal" Spacing="6"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 학사일정 -->
            <Border Grid.Column="1" Style="{StaticResource InfoCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE787;" FontSize="14"/>
                        <TextBlock Text="학사일정" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtScheduleSummary"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtSemesterRange"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 통계 -->
            <Border Grid.Column="2" Style="{StaticResource InfoCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel>
                        <TextBlock x:Name="TxtStatWeeks" Text="0주" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="총 주차" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtStatDays" Text="0일" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="수업일" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtStatHours" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="총 시수" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtStatSectionHours" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="단원 차시" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 주차별 표 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <StackPanel x:Name="HoursEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <FontIcon Glyph="&#xE9D2;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtHoursEmpty"
                               Text="수업을 먼저 선택하세요"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtHoursEmptyHint"
                               FontSize="12"
                               MaxWidth="420"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <ScrollViewer x:Name="HoursScroll"
                              Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="HoursGrid" Margin="8,0,8,8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="TxtHoursSummary"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <InfoBar x:Name="HoursInfoBar"
                     IsOpen="False"
                     Severity="Warning"
                     IsClosable="True"/>
        </StackPanel>
    </Grid>
</UserControl>
