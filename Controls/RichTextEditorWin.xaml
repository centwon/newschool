<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NewSchool.Controls.RichTextEditorWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rich="using:WinUIRichEditor.Controls"
    mc:Ignorable="d"
    Title="편집기">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- 서식 툴바 + 편집기. 용지·방향·여백 칸은 쪽 없이 보는 편집 화면에 쓸모가 없어 숨긴다. -->
        <Border BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <rich:RichEditorToolbar x:Name="EditorToolbar" ToolbarLevel="Maximum"
                                    Target="{x:Bind richEditor}"
                                    ShowPageControls="False"/>
        </Border>
        <rich:RichEditor x:Name="richEditor" Grid.Row="1"/>

        <!-- 하단 버튼 영역 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Padding="16,12">
            <Button x:Name="btnOk"
                    Content="확인"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="80"
                    Click="BtnOk_Click"/>
            <Button x:Name="btnCancel"
                    Content="취소"
                    MinWidth="80"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
