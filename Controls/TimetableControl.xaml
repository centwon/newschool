<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Controls.TimetableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border 
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid x:Name="TimetableGrid"
              Background="{ThemeResource DividerStrokeColorDefaultBrush}"
              ColumnSpacing="1" RowSpacing="1">
            <Grid.RowDefinitions>
                <!-- 헤더 행. 교시 행은 코드비하인드가 PeriodCounts.MaxSupported 만큼 만든다 —
                     여기에 손으로 적어 두면 상한을 늘릴 때 이 파일을 잊는다. -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <!-- 교시 열 -->
                <ColumnDefinition Width="30"/>
                <!-- 월~금 열 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 헤더 행 -->
            <Border Grid.Row="0" Grid.Column="0" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"/>

            <Border Grid.Row="0" Grid.Column="1" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="월" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"/>
                    <!-- 주 단위로 볼 때만 날짜가 붙는다 -->
                    <TextBlock x:Name="DayDate1" HorizontalAlignment="Center"
                               FontSize="10" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="화" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"/>
                    <!-- 주 단위로 볼 때만 날짜가 붙는다 -->
                    <TextBlock x:Name="DayDate2" HorizontalAlignment="Center"
                               FontSize="10" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="3" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="수" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"/>
                    <!-- 주 단위로 볼 때만 날짜가 붙는다 -->
                    <TextBlock x:Name="DayDate3" HorizontalAlignment="Center"
                               FontSize="10" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="4" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="목" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"/>
                    <!-- 주 단위로 볼 때만 날짜가 붙는다 -->
                    <TextBlock x:Name="DayDate4" HorizontalAlignment="Center"
                               FontSize="10" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="5" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="금" HorizontalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"/>
                    <!-- 주 단위로 볼 때만 날짜가 붙는다 -->
                    <TextBlock x:Name="DayDate5" HorizontalAlignment="Center"
                               FontSize="10" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 교시 열(1~n)도 코드비하인드가 만든다 (BuildPeriodRows) -->

            <!-- 시간표 셀들은 코드비하인드에서 동적으로 생성 -->
        </Grid>
    </Border>

</UserControl>
