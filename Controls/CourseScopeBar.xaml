<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Controls.CourseScopeBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="CBoxYear" AutomationProperties.Name="학년도"
                  MinWidth="112"
                  SelectionChanged="OnScopeSelectionChanged"/>
        <ComboBox x:Name="CBoxSemester" AutomationProperties.Name="학기"
                  MinWidth="92"
                  SelectionChanged="OnScopeSelectionChanged"/>
        <ComboBox x:Name="CBoxGrade" AutomationProperties.Name="학년"
                  MinWidth="92"
                  SelectionChanged="OnScopeSelectionChanged"/>

        <Border x:Name="CourseHost">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="4,4"/>
                <TextBlock Text="수업" FontSize="13" VerticalAlignment="Center"/>
                <ComboBox x:Name="CBoxCourse" AutomationProperties.Name="수업"
                          MinWidth="220"
                          PlaceholderText="수업 선택"
                          SelectionChanged="OnCourseSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Course">
                            <TextBlock Text="{x:Bind DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
