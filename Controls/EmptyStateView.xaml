<UserControl
    x:Class="NewSchool.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 화면을 덮는 안내판이라 페이지 배경을 그대로 칠한다.
         밝은 색을 직접 적으면 다크 테마에서 글자가 묻힌다. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Spacing="12"
                    Padding="24">

            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                      FontSize="40"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Button Content="{x:Bind ActionText, Mode=OneWay}"
                    Visibility="{x:Bind ActionVisibility(ActionText), Mode=OneWay}"
                    Click="OnActionClick"
                    HorizontalAlignment="Center"
                    MinWidth="140"
                    Margin="0,4,0,0"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
