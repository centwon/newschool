<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Controls.ProgressMatrixView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NewSchool.Models"
    mc:Ignorable="d">

    <!--
        매트릭스 칸은 단원 수 × 강의실 수만큼 코드에서 만든다.
        색을 코드에 박으면 테마를 바꿔도 그대로 남으므로 스타일로 뺀다.
    -->
    <UserControl.Resources>
        <Style x:Key="MatrixHeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="MatrixDataCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="MatrixHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MatrixDataTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MatrixStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 도구 모음 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="TxtMatrixTitle"
                           Text="진도"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="칸을 눌러 고르고(Ctrl 로 여러 개) 오른쪽 클릭으로 처리합니다."
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnRefreshClick" AutomationProperties.Name="다시 읽기" ToolTipService.ToolTip="다시 읽기">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
                <Button AutomationProperties.Name="격차 분석" x:Name="BtnAnalyze" Click="OnAnalyzeClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                        <TextBlock Text="격차 분석"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="CSV 내보내기" x:Name="BtnExport" Click="OnExportCsvClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14"/>
                        <TextBlock Text="CSV 내보내기"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 매트릭스 -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <StackPanel x:Name="MatrixEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <FontIcon Glyph="&#xE9D5;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtMatrixEmpty"
                               Text="수업을 먼저 선택하세요"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtMatrixEmptyHint"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <ScrollViewer x:Name="MatrixScroll"
                              Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="MatrixGrid" Margin="8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 요약 + 범례 -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="TxtMatrixSummary"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <InfoBar x:Name="MatrixInfoBar"
                         IsOpen="False"
                         Severity="Warning"
                         IsClosable="True"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="✓" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="완료" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="+" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="보강" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="M" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="병합" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="S" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="건너뜀" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="X" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="결강" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
