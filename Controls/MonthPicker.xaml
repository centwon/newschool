<UserControl
    x:Class="NewSchool.Controls.MonthPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NewSchool.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 색상 정의 -->
            <!-- 고정색 정의를 걷어냈다. 여기 있던 밝은 하늘색·연회색은 다크 테마에서
                 배경만 밝아지고 글씨는 테마 기본색(흰색)을 따라가 서로를 삼켰다.
                 아래 사용처가 ThemeResource 를 직접 쓴다. -->

            <!-- 월 선택 박스 스타일 -->
            <Style x:Key="MonthBoxStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="3"/>
            </Style>

            <!-- 월 텍스트 스타일 -->
            <Style x:Key="MonthTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 네비게이션 버튼 스타일 -->
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="BackgroundBorder" 
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 메인 버튼 스타일 -->
            <Style x:Key="MainButtonStyle" TargetType="Button">
                <!-- 흰색 고정이었다 — 글자는 테마 기본색이라 다크에서 흰 배경에 흰 글씨가 됐다 -->
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="BackgroundBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0" 
                                                          HorizontalAlignment="Left" 
                                                          VerticalAlignment="Center"/>
                                        <FontIcon Grid.Column="1" 
                                                  Glyph="&#xE70D;" 
                                                  FontSize="12" 
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ⚠ AutomationProperties.Name 을 달지 말 것. 이 단추의 Content 는 코드가
             "2026년 9월" 로 채우므로 그것이 곧 UIA 이름이고, 달을 옮길 때마다 따라 바뀐다.
             54차의 일괄 작업이 아래 Flyout 안 첫 글자("1월")를 집어 와 고정 이름으로
             붙여 놔, 어느 달을 보고 있든 늘 "1월" 이라고 읽었다(55차 실측으로 잡음). -->
        <Button x:Name="BtnMonth"
                Style="{StaticResource MainButtonStyle}"
                HorizontalAlignment="Left"
                Click="BtnMonth_Click">
            <Button.Flyout>
                <Flyout x:Name="PopMonth" 
                        Placement="Bottom"
                        ShouldConstrainToRootBounds="False">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="BorderThickness" Value="0.5"/>
                            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </Flyout.FlyoutPresenterStyle>

                    <!-- ⚠ IsTabStop 이 없으면 아래 KeyDown 은 **영영 오지 않는다**.
                         Grid 는 기본적으로 포커스를 못 받아 OnFlyoutOpened 의
                         GridMonth.Focus() 가 조용히 실패하고, 포커스는 ◀ 버튼에 머문다.
                         그러면 방향키·Enter 처리가 통째로 죽은 코드가 된다(54차 실측 —
                         팝업을 키보드로 열어도 열두 달 중 아무것도 고를 수 없었다).
                         형제 셋(CourseTimetableBoard·WeeklyTimetableView·ProgressMatrixView)은
                         이미 이 짝을 제대로 달고 있었다. 선택된 달 강조가 곧 포커스 표시라
                         시스템 포커스 테두리는 끈다. -->
                    <Grid x:Name="GridMonth"
                          Width="200"
                          Background="{ThemeResource FlyoutPresenterBackground}"
                          CornerRadius="12"
                          Padding="8"
                          IsTabStop="True"
                          UseSystemFocusVisuals="False"
                          KeyDown="GridMonth_KeyDown">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 (년도 네비게이션) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    x:Name="BtnPrevious"
                                    AutomationProperties.Name="이전 해" ToolTipService.ToolTip="이전 해"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Click="BtnPrevious_Click">
                                <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                            </Button>

                            <TextBlock Grid.Column="1"
                                       x:Name="LbYear" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <Button Grid.Column="2"
                                    x:Name="BtnNext"
                                    AutomationProperties.Name="다음 해" ToolTipService.ToolTip="다음 해"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Click="BtnNext_Click">
                                <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                            </Button>
                        </Grid>

                        <!-- 월 그리드 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- 1-4월 -->
                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="0" Grid.Column="0" 
                                    x:Name="Month1" Tag="1"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="1월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="0" Grid.Column="1" 
                                    x:Name="Month2" Tag="2"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="2월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="0" Grid.Column="2" 
                                    x:Name="Month3" Tag="3"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="3월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="0" Grid.Column="3" 
                                    x:Name="Month4" Tag="4"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="4월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <!-- 5-8월 -->
                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="1" Grid.Column="0" 
                                    x:Name="Month5" Tag="5"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="5월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="1" Grid.Column="1" 
                                    x:Name="Month6" Tag="6"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="6월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="1" Grid.Column="2" 
                                    x:Name="Month7" Tag="7"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="7월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="1" Grid.Column="3" 
                                    x:Name="Month8" Tag="8"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="8월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <!-- 9-12월 -->
                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="2" Grid.Column="0" 
                                    x:Name="Month9" Tag="9"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="9월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="2" Grid.Column="1" 
                                    x:Name="Month10" Tag="10"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="10월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="2" Grid.Column="2" 
                                    x:Name="Month11" Tag="11"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="11월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>

                            <Border Style="{StaticResource MonthBoxStyle}" 
                                    Grid.Row="2" Grid.Column="3" 
                                    x:Name="Month12" Tag="12"
                                    PointerPressed="Month_PointerPressed"
                                    PointerEntered="Month_PointerEntered"
                                    PointerExited="Month_PointerExited">
                                <TextBlock Text="12월" Style="{StaticResource MonthTextStyle}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
