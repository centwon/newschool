<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NewSchool.Controls.WeeklyTimetableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        표는 교시 수 × 날짜 수만큼 코드에서 만든다.
        색을 코드에 박으면 테마를 바꿔도 그대로 남으므로 스타일로 뺀다.
    -->
    <UserControl.Resources>
        <!--
            내 수업 칸의 바탕. AccentFillColorSecondaryBrush 는 강조색 원색에 가까워
            칸이 15열로 늘어서면 화면이 파랗게 덮였다. 강조색을 그대로 쓰되 옅게 깐다.

            ⚠ 밝은 색을 고정으로 박지 않는다 — 다크 테마에서 글자를 삼킨다.
              SystemAccentColor 는 테마를 따라가고, 알파는 밑바탕(카드 배경)과 섞이므로
              라이트에서는 파스텔 하늘색, 다크에서는 짙은 남색 기가 도는 바탕이 된다.
              글자색은 ThemeResource 그대로라 양쪽 다 읽힌다.
        -->
        <SolidColorBrush x:Key="WeekUsualFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
        <SolidColorBrush x:Key="WeekUsualStrokeBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.45"/>
        <SolidColorBrush x:Key="WeekBandFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.28"/>
        <Style x:Key="WeekHeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <!-- 열이 좁으므로 좌우 여백을 줄여 글자가 쓸 폭을 남긴다 -->
            <Setter Property="Padding" Value="3,4"/>
        </Style>

        <!-- 주 구분 줄 -->
        <Style x:Key="WeekBandStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WeekBandFillBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- 날짜 칸 -->
        <Style x:Key="WeekDateCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <!-- 열이 좁으므로 좌우 여백을 줄여 글자가 쓸 폭을 남긴다 -->
            <Setter Property="Padding" Value="3,4"/>
        </Style>

        <!-- 수업이 없는 날 -->
        <Style x:Key="WeekOffDateCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <!-- 열이 좁으므로 좌우 여백을 줄여 글자가 쓸 폭을 남긴다 -->
            <Setter Property="Padding" Value="3,4"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style x:Key="WeekEmptySlotStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- 평소대로인 칸 -->
        <Style x:Key="WeekUsualSlotStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WeekUsualFillBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WeekUsualStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- 그 날만 다른 칸 (교체·보강·대강) -->
        <Style x:Key="WeekChangedSlotStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- 휴강 -->
        <Style x:Key="WeekCancelledSlotStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="WeekHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 주 구분 줄 글씨 — 다섯 열에 걸쳐 있으므로 가운데에 놓는다.
             열이 좁아 넘칠 수 있으니 잘림 표시를 둔다(전문은 툴팁에 있다). -->
        <Style x:Key="WeekBandTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="WeekDateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 오늘 — 글자를 덧붙이면 열 너비를 먹으므로 색으로 알린다. -->
        <Style x:Key="WeekTodayDateTextStyle" TargetType="TextBlock"
               BasedOn="{StaticResource WeekDateTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        </Style>

        <Style x:Key="WeekReasonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="WeekSubjectStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="WeekSubjectStruckStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>

        <Style x:Key="WeekRoomTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 도구 모음 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnPreviousClick" ToolTipService.ToolTip="한 주 앞으로">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                </Button>
                <Button Content="이번 주" Click="OnTodayClick"/>
                <Button Click="OnNextClick" ToolTipService.ToolTip="한 주 뒤로">
                    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                </Button>

                <TextBlock x:Name="TxtRange"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="칸을 오른쪽 클릭해 (휴)휴강 · (보)보강 · (대)대강을 넣습니다. 칸끼리 끌면 맞바꾸기(교체). 마우스 휠은 가로로 넘기고, Shift+휠은 위아래입니다. 평소 시간표는 그대로입니다."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Click="OnRefreshClick" ToolTipService.ToolTip="다시 읽기">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
                <Button Click="OnChangeListClick"
                        ToolTipService.ToolTip="오늘 이후로 등록된 변경을 모두 훑어봅니다">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE787;" FontSize="14"/>
                        <TextBlock Text="변경 목록"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            표 — 교시가 행, 날짜가 열이다. 3주치 15일이 가로로 늘어서므로 가로로 흐른다.

            왼쪽 교시 열(PeriodGrid)만 스크롤 <b>밖</b>에 둔다. 오른쪽으로 밀어도 몇 교시인지
            보여야 하기 때문이다. 두 표는 코드가 같은 RowDefinition 높이로 함께 만들어 줄을 맞춘다
            (한쪽만 Auto 로 두면 내용에 따라 높이가 갈라져 한 칸씩 어긋난다).

            바깥 ScrollViewer 는 세로만, 안쪽은 가로만 맡는다 — 그래서 세로로 밀면 교시 열도
            같이 따라 올라간다.
        -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer x:Name="OuterScroll"
                          VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <Grid Margin="8" PointerWheelChanged="OnTableWheel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 고정 열: 교시 -->
                    <Grid x:Name="PeriodGrid" Grid.Column="0"/>

                    <ScrollViewer x:Name="WeekScroll" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <Grid x:Name="WeekGrid"
                              IsTabStop="True"
                              UseSystemFocusVisuals="False"
                              KeyDown="OnGridKeyDown"
                              GotFocus="OnGridGotFocus"
                              LostFocus="OnGridLostFocus"/>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock x:Name="TxtStatus"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <InfoBar x:Name="WeekInfoBar"
                     IsOpen="False"
                     Severity="Warning"
                     IsClosable="True"/>
        </StackPanel>
    </Grid>
</UserControl>
