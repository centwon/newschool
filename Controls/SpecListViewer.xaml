<UserControl
    x:Class="NewSchool.Controls.SpecListViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NewSchool.ViewModels"
    xmlns:conv="using:NewSchool.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 체크박스가 배경과 구분되지 않아 안 보이는 문제 방지: 테두리 색 고정 -->
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="Gray"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="Gray"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent"/>

        <!-- 한도를 넘긴 줄의 바이트 표시를 빨갛게 — 입력 화면과 같은 기준 -->
        <conv:BoolToWarningBrushConverter x:Key="OverLimitBrush"/>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 헤더 -->
                <RowDefinition Height="*"/>
                <!-- 목록 -->
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Grid x:Name="HeaderGrid"
                  Grid.Row="0"
                  Padding="8,10"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <!-- 체크박스 -->
                    <ColumnDefinition x:Name="ColYearHeader" Width="60"/>
                    <!-- 학년도 -->
                    <ColumnDefinition x:Name="ColTypeHeader" Width="100"/>
                    <!-- 유형 -->
                    <ColumnDefinition x:Name="ColGradeHeader" Width="40"/>
                    <!-- 학년 -->
                    <ColumnDefinition x:Name="ColClassHeader" Width="40"/>
                    <!-- 반 -->
                    <ColumnDefinition x:Name="ColNumberHeader" Width="40"/>
                    <!-- 번호 -->
                    <ColumnDefinition x:Name="ColNameHeader" Width="60"/>
                    <!-- 이름 -->
                    <ColumnDefinition x:Name="ColSubjectHeader" Width="130"/>
                    <!-- 과목/분야 — 학생 이름 바로 오른쪽이 읽기 편하다 -->
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <!-- 기록 내용 -->
                    <ColumnDefinition Width="120"/>
                    <!-- 바이트 정보 -->
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkSelectAll" AutomationProperties.Name="모두 선택"
                          Grid.Column="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MinWidth="0"
                          Padding="0"
                          FontSize="14"
                          BorderBrush="Gray"
                          Checked="OnSelectAllChecked"
                          Unchecked="OnSelectAllUnchecked"/>

                <TextBlock Grid.Column="1" x:Name="TxtYearHeader" Text="학년도" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="TxtTypeHeader" Text="유형" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="7" x:Name="TxtSubjectHeader" Text="과목/분야" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="TxtGradeHeader" Text="학년" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="TxtClassHeader" Text="반" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" x:Name="TxtNumberHeader" Text="번호" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" x:Name="TxtNameHeader" Text="이름" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="8" Text="기록 내용" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="9" Text="Byte/글자수" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Grid>

            <!-- 목록 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                
                <ItemsRepeater x:Name="SpecItemsRepeater"
                               Margin="0">
                    
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudentSpecialViewModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,8">

                                <Grid Loaded="OnDataRowGridLoaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 체크박스 -->
                                    <CheckBox Grid.Column="0" AutomationProperties.Name="이 기록 선택"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              Padding="0"
                                              FontSize="14"
                                              BorderBrush="Gray"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>

                                    <!-- 학년도 -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{x:Bind Year}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"/>

                                    <!-- 유형 -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{x:Bind Type}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- 과목/분야 — 영역에 따라 담기는 정보가 달라 한 칸을 공유한다.
                                         교과 세특: "국어 (2학기)" 표시 전용
                                         진로활동:  희망분야를 여기서 직접 편집(분량이 특기사항과 합산) -->
                                    <TextBlock Grid.Column="7" 
                                               Text="{x:Bind SubjectDisplay}"
                                               Visibility="{x:Bind SubjectTextVisibility}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="7"
                                             AutomationProperties.Name="희망분야" Text="{x:Bind TitleEditable, Mode=TwoWay}"
                                             Visibility="{x:Bind TitleEditVisibility}"
                                             PlaceholderText="희망분야"
                                             VerticalAlignment="Center"
                                             Margin="4,0"
                                             FontSize="14"/>

                                    <!-- 학년 -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Grade}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"/>

                                    <!-- 반 -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind ClassNum}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"/>

                                    <!-- 번호 -->
                                    <TextBlock Grid.Column="5"
                                               Text="{x:Bind Number}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"/>

                                    <!-- 이름 -->
                                    <TextBlock Grid.Column="6"
                                               Text="{x:Bind StudentName}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                    <!-- 기록 내용 — 글자 크기만 툴바 슬라이더를 따른다(다른 칸은 고정) -->
                                    <TextBox Grid.Column="8"
                                             AutomationProperties.Name="기록 내용" Text="{x:Bind Content, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="60"
                                             MaxHeight="200"
                                             FontSize="{x:Bind ContentFontSize, Mode=OneWay}"
                                             PlaceholderText="기록 내용 입력"
                                             TextChanged="OnContentChanged"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                    <!-- 바이트 정보 -->
                                    <TextBlock Grid.Column="9"
                                               Text="{x:Bind ByteInfo, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{x:Bind IsOverByteLimit, Mode=OneWay, Converter={StaticResource OverLimitBrush}}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Margin="0,4,4,0"
                                               TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
